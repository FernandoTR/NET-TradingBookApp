@model Web.Models.EmployeesViewModel

@{
    Layout = null;
}


@using (Html.BeginForm("Save", "Employees", FormMethod.Post, new { id = "frmdata" }))
{
    @Html.AntiForgeryToken()
    <div class="kt-card-content grid gap-5">
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Number, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Number, new { @class = "kt-input" })

            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Name, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Name, new { @class = "kt-input" })
            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.LastName, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.LastName, new { @class = "kt-input" })
            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Email, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Email, new { @class = "kt-input" })
            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Location, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Location, new { @class = "kt-input" })
            </div>
        </div>
        <!--end::Input group-->
    </div>

    <!--begin::Actions-->
    <div class="kt-modal-footer gap-2.5 justify-end">
        <button type="button" id="kt_modal_new_target_cancel" class="kt-btn kt-btn-secondary" data-kt-modal-dismiss="#vModal">Cancelar</button>
        <button type="button" id="btnSave" class="kt-btn kt-btn-primary">Guardar</button>
    </div>
    <!--end::Actions-->
    /* campos para validaciones */
    @Html.HiddenFor(d => d.EmployeeNumberTemp)
    @Html.HiddenFor(d => d.EmailTemp)
}




<script>

    $(document).ready(function () {
            const form = document.getElementById('frmdata');
            const submitButton = document.getElementById('btnSave');

            const validator = FormValidation.formValidation(form,
                            {
                                fields: {
                                            'Number': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'El número de empleado es obligatorio'
                                                    },
                                                    stringLength: {
                                                        min: 2,
                                                        max: 7,
                                                        message: 'Debe tener entre 2 y 7 caracteres'
                                                    },
                                                    remote: {
                                                        message: 'El número de empleado ya está repetido',
                                                        method: 'POST',
                                                        url: '/Employees/CheckDuplicateKey',
                                                        data: function () {
                                                            return {
                                                                employeedNumber: form.querySelector('[name="Number"]').value,
                                                                employeedNumberTemp: form.querySelector('[name="EmployeeNumberTemp"]').value
                                                            };
                                                        }
                                                    }
                                                }
                                            },
                                            'Name': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'El Nombre(s) es obligatorio'
                                                    },
                                                    stringLength: {
                                                        min: 2,
                                                        max: 100,
                                                        message: 'Debe tener entre 2 y 100 caracteres'
                                                    }
                                                }
                                            },
                                            'LastName': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'Los Apellidos son obligatorios'
                                                    },
                                                    stringLength: {
                                                        min: 2,
                                                        max: 100,
                                                        message: 'Debe tener entre 2 y 100 caracteres'
                                                    }
                                                }
                                            },
                                            'Email': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'El Correo es obligatorio'
                                                    },
                                                    stringLength: {
                                                        max: 100,
                                                        message: 'Sobrepasa el límite de 100 caracteres'
                                                    },
                                                    emailAddress: {
                                                        message: 'Correo inválido'
                                                    },
                                                    remote: {
                                                        message: 'El correo ya se encuentra registrado',
                                                        method: 'POST',
                                                        url: '/Employees/CheckDuplicateEmail',
                                                        data: function () {
                                                            return {
                                                                email: form.querySelector('[name="Email"]').value,
                                                                emailTemp: form.querySelector('[name="EmailTemp"]').value
                                                            };
                                                        }
                                                    }
                                                }
                                            },
                                            'Location': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'El Ubicación es obligatorio'
                                                    }
                                                }
                                            },
                                        },

                                plugins: {
                                        trigger:
                                                new FormValidation.plugins.Trigger(),
                                        submitButton:
                                                new FormValidation.plugins.SubmitButton(),
                                        message:
                                                new FormValidation.plugins.Message({
                                                    clazz: 'text-red-500 text-sm mt-1',
                                                    container: function (field, element) {
                                                    return element.closest('.fv-row');
                                                    }
                                                }),
                                }
                            }
            )
            .on('core.element.validated', function (e) {

                    if (e.valid) {
                        e.element.classList.remove('border-destructive','ring-1','ring-red-500');
                        e.element.classList.add('border-green-500');
                    } else {
                        e.element.classList.remove('border-green-500');
                        e.element.classList.add('border-destructive','ring-1','ring-red-500');
                    }
            });

        submitButton.addEventListener('click', function (e) {
                e.preventDefault();

                validator.validate().then(function (status) {

                if (status === 'Valid') {

                    submitButton.disabled = true;

                    form.submit();
                }
            });
        });


    });

</script>
