@model List<Web.Models.EmployeesViewModel>
@{
    ViewBag.Title = "Empleados";
}

<!-- Header Container -->
<div class="kt-container-fixed">
	<div class="flex flex-wrap items-center lg:items-end justify-between gap-5 pb-7.5">
		<div class="flex flex-col justify-center gap-2">
			<h1 class="text-xl font-medium leading-none text-mono">
				Empleados
			</h1>
			<div class="flex items-center gap-2 text-sm font-normal text-secondary-foreground">
				Gestiona empleados, accesos y estados del sistema.
			</div>
		</div>
		<div class="flex items-center gap-2.5">

			<a class="kt-btn kt-btn-primary" href="javascript:showModalForNew()">
				<i class="ki-filled ki-plus text-sm"></i>
				Nuevo
			</a>
		</div>
	</div>
</div>
<!-- End of Header Container -->
<!-- Container -->
<div class="kt-container-fixed">
	<div class="grid" bis_skin_checked="1">
		<div class="kt-card  kt-card-grid h-full min-w-full border border-white/5 shadow-2xs" bis_skin_checked="1">
            <div class="kt-card-table kt-scrollable-x-auto" bis_skin_checked="1">
				<table class="kt-table" data-kt-datatable-table="true" id="dtTable"></table>
            </div>

        </div>
	</div>
</div>
<!-- End of Container -->




@section scripts {
	<script src="~/Template/assets/vendors/datatables-net/dataTables.min.js"></script>
	<script>
		$(document).ready(function () {

			// Función para cargar datos en la tabla
			function loadTableDate() {

					// Evita reinicialización incorrecta
					if ($.fn.DataTable.isDataTable('#dtTable')) {
						$('#dtTable').DataTable().destroy();
					}

					$('#dtTable').DataTable({
						ajax: {
							url: "@Url.Content("~/Employees/JsonDataTable")",
							type: "POST",
							dataType: "json"
						},
						columns: [
							{
								name: "number",
								title: "Número",
								data: "number",
								className: "min-w-[50px]"
							},
							{
								name: "name",
								title: "Nombre(s)",
								data: "name",
								className: "min-w-[100px]"
							},
							{
								name: "lastName",
								title: "Apellido(s)",
								data: "lastName",
								className: "min-w-[100px]"
							},
							{
								name: "statusName",
								title: "Estado",
								data: "statusName",
								className: "text-center min-w-[100px]",
								render: function (data) {

										if (data === 'Activo') {

										return `
										<span class="inline-flex items-center rounded-full bg-green-500/10 text-green-400 px-2.5 py-1 text-xs font-medium">
										Activo
										</span>
										`;
										}

										return `
										<span class="inline-flex items-center rounded-full bg-red-500/10 text-red-400 px-2.5 py-1 text-xs font-medium">
										Inactivo
										</span>
										`;
								}
							},
							{
								name: "confirmedEmail",
								title: "Email Confirmado",
								data: "confirmedEmail",
								className: "text-center min-w-[100px]",
								render: function (data) {
										return data
										? '<i class="ki-filled ki-check-circle text-lg" style="color:#4ade80 !important;"></i>'
										: '<i class="ki-filled ki-check-circle text-lg" style="color:#4ade80 !important;"></i>';
								}
							},
							{
								name: "haveUser",
								title: "Tiene Usuario",
								data: "haveUser",
								className: "text-center min-w-[100px]",
								render: function (data) {

										return data
										? '<i class="ki-filled ki-check-circle text-lg" style="color:#4ade80 !important;"></i>'
										: '<i class="ki-filled ki-check-circle text-lg" style="color:#4ade80 !important;"></i>';
								}
							},
							{
								name: "task",
								title: "",
								data: "task",
								orderable: false,
								className: "text-center min-w-[40px] w-[60px]"
							}
						],
						processing: true,
						serverSide: true,
						pageLength: 10,
						searching: true,
						language: {
							processing: "Procesando...",
							lengthMenu: "Mostrar _MENU_ registros",
							zeroRecords: "No se encontraron resultados",
							emptyTable: "Ningún dato disponible en esta tabla",
							info: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
							infoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
							infoFiltered: "(filtrado de un total de _MAX_ registros)",
							search: "",
							searchPlaceholder: "Buscar empleados...",
							paginate: {
								first: "Primero",
								last: "Último",
								next: "›",
								previous: "‹"
							},
							aria: {
								orderable: "Activar para ordenar ascendente",
								orderableReverse: "Activar para ordenar descendente"
							}
						},
						layout: {
							topStart: [],
							topEnd: 'search',
							bottomStart: ['pageLength', 'info'],
							bottomEnd: 'paging'
						},
						initComplete: function () {

								const searchContainer = $('.dt-search');

								searchContainer.find('label').remove();

								searchContainer.html(`
								<div class="kt-input max-w-48 relative">
								<i class="ki-filled ki-magnifier text-sm text-secondary-foreground"></i>
								<input
									id="dt-search-0"
									type="text"
									class="w-full "
									placeholder="Buscar empleados..."
								/>
								</div>
								`);

								searchContainer.find('input').on('keyup', function () {
									$('#dtTable').DataTable().search(this.value).draw();
								});

						}
					});
			}

			// Recargar datos de la tabla
			loadTableDate();
		});


		function showModal(urlContent, title, subtitle) {

			fetch(urlContent).then((response) => {
				return response.text();
			}).then((data) => {
				$("#contentvModal").html(data);
				$('#title-modal').html(title);
				$('#subtitle-modal').html(subtitle);

				const modalEl = document.querySelector('#vModal');
				const modal = KTModal.getInstance(modalEl);
				modal.show();

				$("#EmployeeNumber").focus();
			});
		}

		
		function showModalForNew() {
			urlContentModal = "@Url.Content("~/Employees/New")";
			showModal(urlContentModal, 'Nuevo Empleado','');
			// $('[data-toggle="tooltip"]').tooltip()
		}

		function showModalForUpdate(id) {
			urlContentModal = "@Url.Content("~/Employees/Edit/?id=")" + id;
			showModal(urlContentModal, 'Editar Empleado','')
		}

		function showModalForCreateUser(id) {
			urlContentModal = "@Url.Content("~/Account/SignUp/?id=")" + id;
			showModal(urlContentModal, 'Generar Usuario','')
		}

		 function toDeleteEmployee(id) {
			const modalEl = document.querySelector('#confirmDialog');
			const modal = KTModal.getInstance(modalEl);

			$("#confirmButtonYes").bind('click', () => {
				$("#confirmButtonYes").unbind('click');
				modal.hide();
				processingDelete(id);
			});
			$('#confirmDialogContent').html('¿Esta usted seguro de eliminar el empleado?')
			$('#confirmTitle').html('Dar de baja empleado');
			modal.show();
		}

		function showModalForResendMail(id) {
			const modalEl = document.querySelector('#confirmDialog');
			const modal = KTModal.getInstance(modalEl);
			$("#confirmButtonYes").bind('click', () => {
				$("#confirmButtonYes").unbind('click');
				modal.hide();
				processingForwardMail(id);
			});
			$('#confirmDialogContent').html('¿Reenviar el correo de verificación?');
			$('#confirmTitle').html('Reenviar verificación');
			modal.show();
		}

		 //Metodo para procesar el reenvio del correo
		function processingForwardMail(id) {


			var urlConfirmModal = "@Url.Content("~/Employees/ForwardMail")";
			fetch(urlConfirmModal, {
				method: 'POST',
				body: JSON.stringify(id), // data can be `string` or {object}!
				headers: {
					'Content-Type': 'application/json'
				}
			}).then(res => res.text())
				.catch(error => console.error('Error:', error))
				.then((data) => {
					if (data === 'true') {
						var urlIndex = "@Html.Raw(Url.Action("Index", "Employees", new { message = "Se reenvio correctamente el correo", notification = "Success" }))";
					} else {
						var urlIndex = "@Html.Raw(Url.Action("Index", "Employees", new { message = "Ocurrio un problema", notification = Web.Models.Enums.NotificationType.Error }))";
					}
				   //alert(urlIndex);
					window.location.href = urlIndex;
				});
		}

		function processingDelete(id) {
			
			var urlConfirmModal = "@Url.Content("~/Employees/Delete")";
			fetch(urlConfirmModal, {
				method: 'POST',
				body: JSON.stringify(id), // data can be `string` or {object}!
				headers: {
					'Content-Type': 'application/json'
				}
			}).then(res => res.text())
				.catch(error => console.error('Error:', error))
				.then((data) => {
					if (data === 'true') {
						var urlIndex = "@Html.Raw(Url.Action("Index", "Employees", new { message = "Se actualizó el estatus del empleado", notification = "Success" }))";
					} else {
						var urlIndex = "@Html.Raw(Url.Action("Index", "Employees", new { message = "Ocurrio un problema", notification = Web.Models.Enums.NotificationType.Error }))";
					}
				   //alert(urlIndex);
					window.location.href = urlIndex;
				});
		}
	</script>


}
