@model Web.Models.CatInstrumentsViewModels

@{
    Layout = null;
}

@using (Html.BeginForm("Update", "CatInstruments", FormMethod.Post, new { id = "frmdata" }))
{
    @Html.AntiForgeryToken()
     <div class="kt-card-content grid gap-5">
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Name, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Name, new { @class = "kt-input" })

            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Ticker, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Ticker, new { @class = "kt-input" })

            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.InstrumentType, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.InstrumentType, new { @class = "kt-input" })

            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Currency, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Currency, new { @class = "kt-input" })

            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Market, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Market, new { @class = "kt-input" })

            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.LinkIcon, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.LinkIcon, new { @class = "kt-input" })

            </div>
        </div>
        <!--end::Input group-->
     </div>

    <!--begin::Actions-->
    <div class="kt-modal-footer gap-2.5 justify-end">
        <button type="button" id="kt_modal_new_target_cancel" class="kt-btn kt-btn-secondary" data-kt-modal-dismiss="#vModal">Cancelar</button>
        <button type="button" id="btnSave" class="kt-btn kt-btn-primary">Guardar</button>
    </div>
    <!--end::Actions-->
    <div hidden>
        @Html.HiddenFor(d => d.Id)
        @Html.HiddenFor(d => d.IsActived)
    </div>
}


<script>

    $(document).ready(function () {
            const form = document.getElementById('frmdata');
            const submitButton = document.getElementById('btnSave');

            const validator = FormValidation.formValidation(form,
                            {
                                fields: {
                                            'Name': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'El nombre es obligatorio'
                                                    },
                                                    stringLength: {
                                                        min: 1,
                                                        max: 100,
                                                        message: 'Debe tener entre 1 y 100 caracteres'
                                                    },
                                                }
                                            },
                                            'Ticker': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'La ticker es obligatorio'
                                                    },
                                                    stringLength: {
                                                        min: 1,
                                                        max: 20,
                                                        message: 'Debe tener entre 1 y 20 caracteres'
                                                    }
                                                }
                                            },
                                            'InstrumentType': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'La tipo de instrumento es obligatorio'
                                                    },
                                                    stringLength: {
                                                        min: 1,
                                                        max: 20,
                                                        message: 'Debe tener entre 1 y 20 caracteres'
                                                    }
                                                }
                                            },
                                            'Currency': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'La moneda es obligatoria'
                                                    },
                                                    stringLength: {
                                                        min: 1,
                                                        max: 10,
                                                        message: 'Debe tener entre 1 y 10 caracteres'
                                                    }
                                                }
                                            },
                                            'Market': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'El mercado es obligatorio'
                                                    },
                                                    stringLength: {
                                                        min: 1,
                                                        max: 50,
                                                        message: 'Debe tener entre 1 y 50 caracteres'
                                                    }
                                                }
                                            },
                                        },

                                plugins: {
                                        trigger:
                                                new FormValidation.plugins.Trigger(),
                                        submitButton:
                                                new FormValidation.plugins.SubmitButton(),
                                        message:
                                                new FormValidation.plugins.Message({
                                                    clazz: 'text-red-500 text-sm mt-1',
                                                    container: function (field, element) {
                                                    return element.closest('.fv-row');
                                                    }
                                                }),
                                }
                            }
            )
            .on('core.element.validated', function (e) {

                    if (e.valid) {
                        e.element.classList.remove('border-destructive','ring-1','ring-red-500');
                        e.element.classList.add('border-green-500');
                    } else {
                        e.element.classList.remove('border-green-500');
                        e.element.classList.add('border-destructive','ring-1','ring-red-500');
                    }
            });

        submitButton.addEventListener('click', function (e) {
                e.preventDefault();

                validator.validate().then(function (status) {

                if (status === 'Valid') {

                    submitButton.disabled = true;

                    form.submit();
                }
            });
        });


    });

</script>
