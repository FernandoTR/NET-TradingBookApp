@model List<Web.Models.CatAccountTypeViewModel>
@{
    ViewBag.Title = "Tipos de Cuenta";
}

<!-- Header Container -->
<div class="kt-container-fixed">
	<div class="flex flex-wrap items-center lg:items-end justify-between gap-5 pb-7.5">
		<div class="flex flex-col justify-center gap-2">
			<h1 class="text-xl font-medium leading-none text-mono">
				Tipos de Cuenta
			</h1>
			<div class="flex items-center gap-2 text-sm font-normal text-secondary-foreground">
				Gestiona catálogos de tipos de cuenta del sistema.
			</div>
		</div>
		<div class="flex items-center gap-2.5">

			<a class="kt-btn kt-btn-primary" href="javascript:showModalForNew()">
				<i class="ki-filled ki-plus text-sm"></i>
				Nuevo
			</a>
		</div>
	</div>
</div>
<!-- End of Header Container -->
<!-- Container -->
<div class="kt-container-fixed">
	<div class="grid" bis_skin_checked="1">
		<div class="kt-card  kt-card-grid h-full min-w-full border border-white/5 shadow-2xs" bis_skin_checked="1">
            <div class="kt-card-table kt-scrollable-x-auto" bis_skin_checked="1">
				<table class="kt-table" data-kt-datatable-table="true" id="dtTable"></table>
            </div>

        </div>
	</div>
</div>
<!-- End of Container -->




@section scripts {
	<script src="~/Template/assets/vendors/datatables-net/dataTables.min.js"></script>
	<script>
		$(document).ready(function () {

			// Función para cargar datos en la tabla
			function loadTableDate() {

					// Evita reinicialización incorrecta
					if ($.fn.DataTable.isDataTable('#dtTable')) {
						$('#dtTable').DataTable().destroy();
					}

					$('#dtTable').DataTable({
						ajax: {
							url: "@Url.Content("~/CatAccountType/JsonDataTable")",
							type: "POST",
							dataType: "json"
						},
						columns: [
							{
								name: "id",
								title: "Número",
								data: "id",
								className: "min-w-[50px]"
							},
							{
								name: "code",
								title: "Código",
								data: "code",
								className: "min-w-[100px]"
							},
							{
								name: "description",
								title: "Descripción",
								data: "description",
								className: "min-w-[200px]"
							},
							{
								name: "isActived",
								title: "Estado",
								data: "isActived",
								className: "text-center min-w-[100px]",
								render: renderStatus
							},
							{
								name: "task",
								title: "",
								data: "task",
								orderable: false,
								className: "text-center min-w-[40px] w-[60px]"
							}
						],
						processing: true,
						serverSide: true,
						pageLength: 10,
						searching: true,
						language: {
							processing: "Procesando...",
							lengthMenu: "Mostrar _MENU_ registros",
							zeroRecords: "No se encontraron resultados",
							emptyTable: "Ningún dato disponible en esta tabla",
							info: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
							infoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
							infoFiltered: "(filtrado de un total de _MAX_ registros)",
							search: "",
							searchPlaceholder: "Buscar tipos de cuenta...",
							paginate: {
								first: "Primero",
								last: "Último",
								next: "›",
								previous: "‹"
							},
							aria: {
								orderable: "Activar para ordenar ascendente",
								orderableReverse: "Activar para ordenar descendente"
							}
						},
						layout: {
							topStart: [],
							topEnd: 'search',
							bottomStart: ['pageLength', 'info'],
							bottomEnd: 'paging'
						},
						initComplete: function () {

								const searchContainer = $('.dt-search');

								searchContainer.find('label').remove();

								searchContainer.html(`
								<div class="kt-input max-w-48 relative">
								<i class="ki-filled ki-magnifier text-sm text-secondary-foreground"></i>
								<input
									id="dt-search-0"
									type="text"
									class="w-full "
									placeholder="Buscar tipos de cuenta..."
								/>
								</div>
								`);

								searchContainer.find('input').on('keyup', function () {
									$('#dtTable').DataTable().search(this.value).draw();
								});

						},
						drawCallback: function () {
							KTMenu.createInstances();
						}
					});
			}

			// Recargar datos de la tabla
			loadTableDate();
		});


		function showModal(urlContent, title, subtitle) {

			fetch(urlContent).then((response) => {
				return response.text();
			}).then((data) => {
				$("#contentvModal").html(data);
				$('#title-modal').html(title);
				$('#subtitle-modal').html(subtitle);

				const modalEl = document.querySelector('#vModal');
				const modal = KTModal.getInstance(modalEl);
				modal.show();
			});
		}


		function showModalForNew() {
			urlContentModal = "@Url.Content("~/CatAccountType/New")";
			showModal(urlContentModal, 'Nuevo Tipo','');
		}


		function showModalForUpdate(id) {
			urlContentModal = "@Url.Content("~/CatAccountType/Edit/?id=")" + id;
			showModal(urlContentModal, 'Editar Tipo','')
		}

		function showModaltoDelete(id) {
			const modalEl = document.querySelector('#confirmDialog');
			const modal = KTModal.getInstance(modalEl);

			$("#confirmButtonYes").bind('click', () => {
				$("#confirmButtonYes").unbind('click');
				modal.hide();
				processingDelete(id);
			});
			$('#confirmDialogContent').html('¿Esta usted seguro de eliminar el tipo de cuenta?')
			$('#confirmTitle').html('Dar de baja el tipo de cuenta');
			modal.show();
		}

		function processingDelete(id) {
			var urlConfirmModal = "@Url.Content("~/CatAccountType/Delete")";
			fetch(urlConfirmModal, {
				method: 'POST',
				body: JSON.stringify(id),
				headers: {
					'Content-Type': 'application/json'
				}
			}).then(res => res.text())
				.catch(error => console.error('Error:', error))
				.then((data) => {
					if (data === 'true') {
						var urlIndex = "@Html.Raw(Url.Action("Index", "CatAccountType", new { message = "El tipo de cuenta fue eliminado correctamente.", notification = "Success" }))";
					} else {
						var urlIndex = "@Html.Raw(Url.Action("Index", "CatAccountType", new { message = "Ocurrio un problema", notification = Web.Models.Enums.NotificationType.Error }))";
					}
					window.location.href = urlIndex;
				});
		}

	</script>


}
