	<div class="kt-card-footer p-5 flex gap-3">
		<a class="kt-btn kt-btn-outline" href="javascript:ClearFilterData()" data-kt-drawer-dismiss="true">
			Limpiar
		</a>
		<a class="kt-btn kt-btn-primary grow" href="javascript:SearchData()" data-kt-drawer-dismiss="true" id="btn_AplicarFiltro">			
