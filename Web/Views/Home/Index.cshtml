	</div>
</div>
<!--End of Filter Drawer-->

@section scripts{
	
	<script>
		//--begin::variables para grafico de bloques
		var chartCategories = new Array();
		var chartSeries = new Array();
		var chart;
		//--end::variables para grafico de bloques

		$(document).ready(function () {
			LoadBalanceView();
			LoadChartBlocks(); //inicializa grafico bloques

			SearchData();
			
		});

		function AnimatedProgress(){
			requestAnimationFrame(() => {
				setTimeout(() => {

					document
						.querySelectorAll('.kt-progress-indicator')
						.forEach(el => {

							el.style.width = el.dataset.width + '%';

						});

				}, 500);
			});
		}


		function ClearFilterData() {
			KTSelectHelper.setValue('#CategoryId',1);
			KTSelectHelper.clear('#AccountTypeId');
			KTSelectHelper.clear('#InstrumentId');
			KTSelectHelper.clear('#FrameId');
			KTSelectHelper.clear('#DirectionId');

			LoadAnalyticsTriggerView();
			LoadAnalyticsSceneryView();
			LoadAnalyticsSceneryAutoScoreView();
			LoadAnalyticsTriggerChart();
			LoadAnalyticsLastBlocks();

			AnimatedProgress();
						
		}

		function SearchData() {
			LoadAnalyticsTriggerView();
			LoadAnalyticsSceneryView();
			LoadAnalyticsSceneryAutoScoreView();
			LoadAnalyticsTriggerChart();
			LoadAnalyticsLastBlocks();

			AnimatedProgress();
		}

		function LoadAnalyticsTriggerView(){
			const categoryId = document.querySelector('#CategoryId').value || 0;
			const accountTypeId = document.querySelector('#AccountTypeId').value || 0;
			const instrumentId = document.querySelector('#InstrumentId').value || 0;
			const frameId = document.querySelector('#FrameId').value || 0;
			const directionId = document.querySelector('#DirectionId').value || 0;


			
			var data = {
				categoryId: categoryId,
				accountTypeId: accountTypeId,
				instrumentId: instrumentId,
				frameId: frameId,
				directionId: directionId

			};


			// Realizar la petición POST
			fetch('/Home/AnalyticsTrigger', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json', 
					'Accept': 'text/html'               // Especifica que esperas una vista parcial como respuesta
				},
				body: JSON.stringify(data)       // Convierte los datos a JSON para enviarlos
			})
			.then(response => {
				if (!response.ok) {
					throw new Error(`Error en la petición: ${response.status}`);
				}
				return response.text();             // La respuesta es texto HTML
			})
			.then(html => {
				// Actualizar la interfaz con la vista parcial recibida
				document.getElementById('analyticsTriggersContainer').innerHTML = html;
			})
			.catch(error => {
				console.error('Error:', error);
			});
		}

		function LoadAnalyticsSceneryView(){
			const categoryId = document.querySelector('#CategoryId').value || 0;
			const accountTypeId = document.querySelector('#AccountTypeId').value || 0;
			const instrumentId = document.querySelector('#InstrumentId').value || 0;
			const frameId = document.querySelector('#FrameId').value || 0;
			const directionId = document.querySelector('#DirectionId').value || 0;


			
			var data = {
				categoryId: categoryId,
				accountTypeId: accountTypeId,
				instrumentId: instrumentId,
				frameId: frameId,
				directionId: directionId

			};


			// Realizar la petición POST
			fetch('/Home/AnalyticsScenery', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json', 
					'Accept': 'text/html'               // Especifica que esperas una vista parcial como respuesta
				},
				body: JSON.stringify(data)       // Convierte los datos a JSON para enviarlos
			})
			.then(response => {
				if (!response.ok) {
					throw new Error(`Error en la petición: ${response.status}`);
				}
				return response.text();             // La respuesta es texto HTML
			})
			.then(html => {
				// Actualizar la interfaz con la vista parcial recibida
				document.getElementById('analyticsSceneryContainer').innerHTML = html;
			})
			.catch(error => {
				console.error('Error:', error);
			});
		}
		
		function LoadAnalyticsSceneryAutoScoreView(){
			const categoryId = document.querySelector('#CategoryId').value || 0;
			const accountTypeId = document.querySelector('#AccountTypeId').value || 0;
			const instrumentId = document.querySelector('#InstrumentId').value || 0;
			const frameId = document.querySelector('#FrameId').value || 0;
			const directionId = document.querySelector('#DirectionId').value || 0;


			
			var data = {
			categoryId: categoryId,
			accountTypeId: accountTypeId,
			instrumentId: instrumentId,
			frameId: frameId,
			directionId: directionId

			};


			// Realizar la petición POST
		fetch('/Home/AnalyticsSceneryAutoScore', {
			method: 'POST',
			headers: {
			'Content-Type': 'application/json',
			'Accept': 'text/html'               // Especifica que esperas una vista parcial como respuesta
			},
			body: JSON.stringify(data)       // Convierte los datos a JSON para enviarlos
			})
			.then(response => {
			if (!response.ok) {
			throw new Error(`Error en la petición: ${response.status}`);
			}
			return response.text();             // La respuesta es texto HTML
			})
			.then(html => {
				// Actualizar la interfaz con la vista parcial recibida
				document.getElementById('analyticsSceneryAutoScoreContainer').innerHTML = html;
			})
			.catch(error => {
			console.error('Error:', error);
			});
		}

		function LoadAnalyticsTriggerChart(){
			const categoryId = document.querySelector('#CategoryId').value || 0;
			const accountTypeId = document.querySelector('#AccountTypeId').value || 0;
			const instrumentId = document.querySelector('#InstrumentId').value || 0;
			const frameId = document.querySelector('#FrameId').value || 0;
			const directionId = document.querySelector('#DirectionId').value || 0;

			var data = {
				categoryId: categoryId,
				accountTypeId: accountTypeId,
				instrumentId: instrumentId,
				frameId: frameId,
				directionId: directionId
			};


			// Realizar la petición POST
			fetch('/Home/AnalyticsTriggerChart', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify(data)       // Convierte los datos a JSON para enviarlos
			})
			.then(response => {
				if (!response.ok) {
					throw new Error(`Error en la petición: ${response.status}`);
				}
				return response.json();            
			})
			.then(data => {

				// Declaración de variables con inicialización
				let quantity = 0;
				let sl = 0;
				let tp1 = 0;
				let tp2 = 0;
				let tp3 = 0;

				// Iteración y acumulación de datos
				data.forEach(item => {

					// Sumar valores numéricos a las variables acumulativas
					quantity += parseInt(item.quantity, 10) || 0; // Asegurarse de que sea un número
					sl += parseInt(item.sl, 10) || 0;
					tp1 += parseInt(item.tP1, 10) || 0;
					tp2 += parseInt(item.tP2, 10) || 0;
					tp3 += parseInt(item.tP3, 10) || 0;
				});

				// Calcular la efectividad
				const slEffectiveness = quantity > 0 ? Math.round((sl * 100) / quantity) : 0;
				const tp1Effectiveness = quantity > 0 ? Math.round((tp1 * 100) / quantity) : 0;
				const tp2Effectiveness = quantity > 0 ? Math.round((tp2 * 100) / quantity) : 0;
				const tp3Effectiveness = quantity > 0 ? Math.round((tp3 * 100) / quantity) : 0;

				$('#lblNumEfectividad').text(tp1Effectiveness + '%');
				$('#lblNumTotalTrades').text(quantity + ' Trades');
				$('#lblStopLoss').text(sl);
				$('#lblTakeProfit1').text(tp1);
				$('#lblTakeProfit2').text(tp2);
				$('#lblTakeProfit3').text(tp3);
				$('#lblStopLossPercentage').text(slEffectiveness);
				$('#lblTakeProfit1Percentage').text(tp1Effectiveness);
				$('#lblTakeProfit2Percentage').text(tp2Effectiveness);
				$('#lblTakeProfit3Percentage').text(tp3Effectiveness);
                
                $('#stopLossBar').animate({
                    width: slEffectiveness +'%'
                }, 300);

                $('#profit1Bar').animate({
                width: tp1Effectiveness +'%'
                }, 300);

                 $('#profit2Bar').animate({
                width: tp2Effectiveness +'%'
                }, 300);

                 $('#profit3Bar').animate({
                width: tp3Effectiveness +'%'
                }, 300);
        


				// Data
				var data = [{
					category: "Stop Loss",
					value: slEffectiveness,
					full: 100,
					columnSettings: {
					fill: am5.color("#FB7185")
					}
				}, {
					category: "Take Profit 1",
					value: tp1Effectiveness,
					full: 100,
					columnSettings: {
					fill: am5.color("#34D399")
					}
				}, {
					category: "Take Profit 2",
					value: tp2Effectiveness,
					full: 100,
					columnSettings: {
					fill: am5.color("#FBBF24")
					}
				}, {
					category: "Take Profit 3",
					value: tp3Effectiveness,
					full: 100,
					columnSettings: {
					fill: am5.color("#A78BFA")
					}
				}];


			})
			.catch(error => {
				console.error('Error:', error);
			});
		}
		
		function LoadChartBlocks() {
			

			var options = {
				series: [{
					name: 'Efectividad',
					data: chartSeries
				}],
				chart: {
					height: 250,
				    type: 'area',
				    toolbar: {
					    show: false,
				    },
				},
				plotOptions: {

				},
				legend: {
					show: false
				},
				dataLabels: {
					enabled: false
				},
				fill: {
                    gradient: {
                    enabled: true,
                    opacityFrom: 0.20,
                    opacityTo: 0,
                    },
				},
				stroke: {
					curve: 'smooth',
					show: true,
					width: 3,
                    colors: ['var(--color-primary)']
				},
				xaxis: {
					categories: chartCategories,
					axisBorder: {
						show: false,
					},
					axisTicks: {
						show: false
					},
					labels: {
						style: {
                            colors: 'var(--color-secondary-foreground)',
							fontSize: '12px'
						}
					},
					crosshairs: {
						position: 'front',
						stroke: {
                            color: 'var(--color-primary)',
							width: 1,
							dashArray: 3
						}
					},
					tooltip: {
                        enabled: false,
						formatter: undefined,
						offsetY: 0,
						style: {
							fontSize: '12px'
						}
					}
				},
				yaxis: {
					min:0,
					max: 100,
                    tickAmount: 5, // This will create 5 ticks: 0, 20, 40, 60, 80, 100
                    axisTicks: {
                        show: false,
                    },
					labels: {
						style: {
                            colors: 'var(--color-secondary-foreground)',
							fontSize: '12px'
						}

					}
				},
