		}

		function LoadAnalyticsLastBlocks(){
			const categoryId = document.querySelector('#CategoryId').value || 0;
			const accountTypeId = document.querySelector('#AccountTypeId').value || 0;
			const instrumentId = document.querySelector('#InstrumentId').value || 0;
			const frameId = document.querySelector('#FrameId').value || 0;
			const directionId = document.querySelector('#DirectionId').value || 0;

			var data = {
				categoryId: categoryId,
				accountTypeId: accountTypeId,
				instrumentId: instrumentId,
				frameId: frameId,
				directionId: directionId

			};

            
			// Realizar la petición POST
			fetch('/Home/AnalyticsLastBlocks', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify(data)       // Convierte los datos a JSON para enviarlos
			})
			.then(response => {
				if (!response.ok) {
					throw new Error(`Error en la petición: ${response.status}`);
				}
				return response.json();             
			})
			.then(data => {
				    //limpiar arreglos del grafico de bloques
					chartCategories.splice(0);
					chartSeries.splice(0);

					if (data.result)
					{
						var porcentaje = new Array();

						$.each(data.list, function (i, item) {
							chartCategories.push(item.blockName);
							porcentaje.push(item.percentage);
						});

						chartSeries.push({
							name: 'Efectividad',
							data: porcentaje
						});

						//actualiza la información del grafico
						chart.updateSeries(chartSeries);
						chart.updateOptions({
							xaxis: {
								categories: chartCategories,
							},
						});

					}
			})
			.catch(error => {
				console.error('Error:', error);
			});
		}

		function showModal(urlContent, title, subtitle) {
			fetch(urlContent).then((response) => {
				return response.text();
			}).then((data) => {
				$("#contentvModal").html(data);
				$('#title-modal').html(title);
				$('#subtitle-modal').html(subtitle);
				$("#vModal").modal("show");
			});
		}

		function showModalForNew() {
			urlContentModal = "@Url.Content("~/Orders/New")";
			showModal(urlContentModal, 'Nueva orden','');
			$('[data-toggle="tooltip"]').tooltip()
		}

		function LoadBalanceView(){
			$.get('@Url.Action("Balance", "Home")', function (data) {
				$('#balance').html(data);
			});
		}
	</script>
