@model Web.Models.AnalyticsTriggerViewModel

<div class="col-span-1">
    <div class="flex flex-col gap-5 lg:gap-7.5">
        <div class="flex flex-col gap-5 lg:gap-7.5">
            <div class="kt-card">
                <div class="kt-card-header">
                    <div>
                        <h3 class="text-[24px] font-semibold tracking-tight text-white">
                            Análisis por Gatillos
                        </h3>
                        @*
                        <p class="text-sm text-slate-400 mt-1">
                            Revisión de efectividad por tipo de gatillo
                        </p> *@
                    </div>
                </div>
                <div class="kt-card-content grid gap-5 lg:gap-7.5 lg:py-7.5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                        @foreach (var trigger in Model.AnalyticsTriggerList)
                        {
                            var statusConfig = trigger.Quantity switch
                            {
                                < 30 => new
                                {
                                    Color = "primary",
                                    Label = "No confiable",
                                    Ring = "text-primary size-10 ring-1 ring-primary/20 bg-primary/5 "
                                },

                                <= 100 => new
                                {
                                    Color = "warning",
                                    Label = "En validación",
                                    Ring = "text-yellow-500 size-10 rounded-2xl ring-1 ring-yellow-200 dark:ring-yellow-950 bg-yellow-50 dark:bg-yellow-950/30"
                                },

                                _ => new
                                {
                                    Color = "success",
                                    Label = "Confiable",
                                    Ring = "text-green-500 size-10 rounded-2xl ring-1 ring-green-200 dark:ring-green-950 bg-green-50 dark:bg-green-950/30"
                                }
                            };

                            <div class="kt-card overflow-hidden grow justify-between">
                                <div class=" grid gap-3 px-5 pt-3.5 pb-3">
                                    <div class="flex items-center gap-3.5">

                                        <!-- Icon -->
                                        <div class="flex justify-center items-center w-full min-h-[45px]">
                                            <div class="flex items-center justify-center w-12 h-12 text-md @statusConfig.Ring rounded-full">
                                                @trigger.Code
                                            </div>
                                        </div>

                                        <!-- Content -->
                                        @* <div class="flex flex-col justify-center">
											<a class="text-sm font-semibold text-mono hover:text-primary leading-none" href="#">
												Escenario @trigger.Description
											</a>

											
											
                                            <div class="mt-2">
                                                <div class="kt-badge kt-badge-sm kt-badge-@statusConfig.Color  kt-badge-light">
													@statusConfig.Label
                                                </div>
                                            </div>

                                        </div> *@
                                    </div>                                 
                                    <div class="flex items-center place-content-between">
                                        <span class="text-secondary-foreground text-xs">
                                            @trigger.Quantity Trades
                                        </span>
                                        <span class="text-secondary-foreground text-xs ">
                                            @trigger.TP1P.ToString("0")%
                                        </span>
                                    </div>
                                </div>
                                <div class="kt-progress kt-progress-@statusConfig.Color h-1">
                                    <div class="kt-progress-indicator" style="width: @trigger.TP1P.ToString("0")%" >
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
                <div class="kt-card-footer border-t border-white/5 p-6 bg-gradient-to-r from-blue-500/10 to-transparent">
                    <div class="flex items-center flex-wrap gap-3.5">
                        <div class="flex justify-center ">
                            <div class="relative size-[50px] shrink-0" bis_skin_checked="1">
                                <svg class="w-full h-full stroke-primary/10 fill-primary-soft" fill="none" height="48" viewBox="0 0 44 48" width="44" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M16 2.4641C19.7128 0.320509 24.2872 0.320508 28 2.4641L37.6506 8.0359C41.3634 10.1795 43.6506 14.141 43.6506
                                        18.4282V29.5718C43.6506 33.859 41.3634 37.8205 37.6506 39.9641L28 45.5359C24.2872 47.6795 19.7128 47.6795 16 45.5359L6.34937
                                        39.9641C2.63655 37.8205 0.349365 33.859 0.349365 29.5718V18.4282C0.349365 14.141 2.63655 10.1795 6.34937 8.0359L16 2.4641Z" fill="">
                                    </path>
                                    <path d="M16.25 2.89711C19.8081 0.842838 24.1919 0.842837 27.75 2.89711L37.4006 8.46891C40.9587 10.5232 43.1506 14.3196 43.1506
                                        18.4282V29.5718C43.1506 33.6804 40.9587 37.4768 37.4006 39.5311L27.75 45.1029C24.1919 47.1572 19.8081 47.1572 16.25 45.1029L6.59937
                                        39.5311C3.04125 37.4768 0.849365 33.6803 0.849365 29.5718V18.4282C0.849365 14.3196 3.04125 10.5232 6.59937 8.46891L16.25 2.89711Z" stroke="">
                                    </path>
                                </svg>
                                <div class="absolute leading-none start-2/4 top-2/4 -translate-y-2/4 -translate-x-2/4 rtl:translate-x-2/4" bis_skin_checked="1">
                                    <i class="ki-filled ki-notification-on text-xl ps-px text-primary">
                                    </i>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-col">
                            <div class="flex items-center gap-1.5">
                                <a class="flex items-center gap-1.5 leading-none font-medium text-sm text-mono" href="#">
                                    @Model.TotalValidRecords Gatillos con una efectividad
                                </a>
                            </div>
                            <span class="text-sm text-secondary-foreground">
                                <a class="kt-link kt-link-underlined kt-link-dashed" href="#">
                                    superior al 70%
                                </a>
                                
                            </span>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>


