@model Web.Models.BalanceViewModel

<style>
	.channel-stats-bg {
		background-image: url('../Template/assets/media/images/2600x1600/bg-3.png');
	}

	.dark .channel-stats-bg {
		background-image: url('../Template/assets/media/images/2600x1600/bg-3-dark.png');
	}
</style>

@foreach (var account in Model.Accounts)
{
	<div class="kt-card flex-col justify-between gap-6 h-full bg-cover rtl:[background-position:-4rem_-4rem] bg-[length:85%] [background-position:9rem_-4rem] bg-no-repeat channel-stats-bg">
		<i class="ki-filled ki-dollar text-2xl text-muted-foreground w-7 mt-4 ms-5"></i>
		<div class="flex flex-col gap-1 pb-4 px-5">
			<span class="text-3xl font-semibold text-mono">
				@account.CurrentBalance.ToString("c2")
				<span class="kt-badge kt-badge-sm text-accent-foreground/60">
					@account.Currency
				</span>
			</span>
			<span class="text-sm font-normal text-secondary-foreground">
				@account.CatAccountType.Description
			</span>
		</div>
	</div>

	
}

