@model Web.Models.AnalyticsSceneryViewModel

<div class="col-span-1">
	<div class="flex flex-col gap-5 lg:gap-7.5">
		<div class="flex flex-col gap-5 lg:gap-7.5">
			<div class="kt-card">
				<div class="kt-card-header">
					<h3 class="kt-card-title"> Análisis de Escenarios Automatizado </h3>
				</div>
				<div class="kt-card-table kt-scrollable-x-auto">
					<table class="kt-table table-fixed">
						<thead>
							<tr>
								<th class="text-start w-[80px]">
									Nombre
								</th>
								<th class="text-end w-[80px]">
									Trades
								</th>
								<th class="text-end w-[100px]">
									Status
								</th>
								<th class="text-end w-[100px]">
									%
								</th>
              
							</tr>
						</thead>
						<tbody>
							@{
								foreach (var scenery in Model.AnalyticsSceneryList)
								{
									string color = (scenery.TP1P >= 70) ? "green-500" : "destructive";
									string icon = (scenery.TP1P >= 70) ? "up" : "down";
									<tr>
										<td class="text-start">
											<div class="flex flex-col" bis_skin_checked="1">
												<a class="text-sm font-semibold text-mono hover:text-primary mb-px" href="#">
													@scenery.Code
												</a>
												<span class="text-xs font-normal text-secondary-foreground">
													@scenery.Quantity Trades
												</span>
											</div>
										</td>
										<td class="text-sm text-foreground text-end">
											@scenery.Quantity
										</td>
										<td class="text-end">
											@if (scenery.Quantity < 30)
											{
												<div class="kt-badge kt-badge-sm kt-badge-primary  kt-badge-outline">No confiable</div>
											}
											else if (scenery.Quantity >= 30 && scenery.Quantity <= 100)
											{
												<div class="kt-badge kt-badge-sm kt-badge-warning  kt-badge-outline">En validación</div>
											}
											else
											{
												<div class="kt-badge kt-badge-sm kt-badge-success kt-badge-outline">Confiable</div>
											}
										</td>
										<td class="text-sm text-foreground text-end">
											<i class="ki-filled ki-arrow-@icon text-@color">
											</i>
											@scenery.TP1P.ToString("0")%
										</td>
               
									</tr>
								}
							}
            
						</tbody>
					</table>
				</div>
				<div class="kt-card-footer justify-center" bis_skin_checked="1">
					<a class="kt-link kt-link-underlined kt-link-dashed" href="#">
						@Model.TotalValidRecords escenarios con una efectividad superior al 70%
					</a>
				</div>
			</div>
          
		</div>
	</div>
</div>




