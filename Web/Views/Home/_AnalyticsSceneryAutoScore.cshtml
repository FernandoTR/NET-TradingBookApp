@model Web.Models.AnalyticsSceneryViewModel

<section class="kt-card h-full w-full min-w-0" aria-labelledby="analytics-scenery-auto-title" style="overflow-wrap: anywhere;">
    <header class="kt-card-header shrink-0 py-4">
        <h3 class="kt-card-title leading-5" id="analytics-scenery-auto-title">Análisis por Escenarios Automatizado</h3>
    </header>

    <div class="kt-card-content p-0">
        @if (Model.AnalyticsSceneryList?.Any() == true)
        {
            <ul>
                @foreach (var scenery in Model.AnalyticsSceneryList)
                {
                    var (color, label) = scenery.Quantity switch
                    {
                        < 30 => ("primary", "No confiable"),
                        <= 100 => ("warning", "En validación"),
                        _ => ("success", "Confiable")
                    };
                    var percentage = Math.Clamp(scenery.TP1P, 0, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture);

                    <li class="kt-card-group flex items-start gap-3 py-4">
                        <span class="flex w-10 shrink-0 items-center justify-center rounded-lg bg-muted py-3 text-center text-xs font-semibold text-mono">@scenery.Code</span>
                        <div class="flex grow min-w-0 flex-col gap-2">
                            <div class="flex items-start justify-between gap-2">
                                <p class="min-w-0 text-sm font-medium leading-5 text-mono">Escenario @scenery.Description</p>
                                <span class="shrink-0 text-lg font-semibold leading-5 text-mono tabular-nums">@scenery.TP1P.ToString("0")%</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2.5 text-xs text-secondary-foreground tabular-nums">
                                <span>@scenery.Quantity.ToString("N0") Trades</span>
                                <span class="kt-badge kt-badge-sm kt-badge-outline">
                                    <span class="size-1.5 shrink-0 rounded-full kt-badge-@color" aria-hidden="true"></span>
                                    @label
                                </span>
                            </div>
                            <div class="kt-progress kt-progress-@color" role="meter" aria-label="Efectividad TP1: escenario @scenery.Description" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percentage">
                                <div class="kt-progress-indicator" style="width: @percentage%"></div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="flex min-h-52 flex-col justify-center gap-2 p-5">
                <p class="text-sm font-medium leading-5 text-mono">@(Model.TotalRecords == 0 ? "Sin escenarios para este filtro" : "Ningún escenario alcanza el 70%")</p>
                <p class="text-xs leading-5 text-secondary-foreground">Prueba con otros filtros para ver la efectividad.</p>
            </div>
        }
    </div>

    <footer class="kt-card-footer h-20 shrink-0 text-xs leading-5 text-secondary-foreground">
        <p><strong class="font-semibold text-mono tabular-nums">@Model.TotalValidRecords</strong> de @Model.TotalRecords escenarios con efectividad de <strong class="font-semibold text-mono">70% o más</strong></p>
    </footer>
</section>
