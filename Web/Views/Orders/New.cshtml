@{
	Layout = null;

	var CategoryItems = (List<SelectListItem>)ViewBag.CategoryItems;
	var AccountTypeItems = (List<SelectListItem>)ViewBag.AccountTypeItems;
	var InstrumentItems = (List<SelectListItem>)ViewBag.InstrumentItems;
	var DayItems = (List<SelectListItem>)ViewBag.DayItems;
	var StageItems = (List<SelectListItem>)ViewBag.StageItems;
	var FigureItems = (List<SelectListItem>)ViewBag.FigureItems;
	var FrameItems = (List<SelectListItem>)ViewBag.FrameItems;
	var TriggerItems = (List<SelectListItem>)ViewBag.TriggerItems;
	var DirectionItems = (List<SelectListItem>)ViewBag.DirectionItems;
	var SceneryItems = (List<SelectListItem>)ViewBag.SceneryItems;
	var OrderTypeItems = (List<SelectListItem>)ViewBag.OrderTypeItems;

}

<form id="kt_modal_stepper_form" novalidate="novalidate">
	<div class="flex grow gap-5 lg:gap-7.5">

		<!-- Sidebar -->
		<div class="hidden lg:block w-[230px] shrink-0">
			<div class="w-[230px] fixed z-10 kt-scrollable-y-auto" data-kt-scrollable="true" data-kt-scrollable-height="auto" data-kt-scrollable-offset="225px" data-kt-scrollable-wrappers="#modal_orders_content">
				<div class="flex flex-col grow relative before:absolute before:left-[11px] before:top-0 before:bottom-0 before:border-l before:border-border" data-kt-scrollspy="true" data-kt-scrollspy-offset="110px" data-kt-scrollspy-target="#modal_orders_body">

					<div class="flex flex-col">
						<div class="pl-6 pr-2.5 py-2.5 text-sm font-semibold text-mono">
							Setup
						</div>
						<div class="flex flex-col">
							<a class="flex items-center rounded-lg pl-2.5 pr-2.5 py-2.5 gap-3.5 active border border-transparent text-sm text-foreground hover:text-primary hover:font-medium kt-scrollspy-active:bg-secondary-active kt-scrollspy-active:text-primary kt-scrollspy-active:font-medium hover:rounded-lg" data-kt-scrollspy-anchor="true" href="#order_general">
								<span class="flex w-1.5 relative before:absolute before:top-0 before:size-1.5 before:rounded-full before:-translate-x-2/4 before:-translate-y-2/4 kt-scrollspy-active:before:bg-primary">
								</span>
								Información Básica
							</a>
							<a class="flex items-center rounded-lg pl-2.5 pr-2.5 py-2.5 gap-3.5 border border-transparent text-sm text-foreground hover:text-primary hover:font-medium kt-scrollspy-active:bg-secondary-active kt-scrollspy-active:text-primary kt-scrollspy-active:font-medium hover:rounded-lg" data-kt-scrollspy-anchor="true" href="#order_context">
								<span class="flex w-1.5 relative before:absolute before:top-0 before:size-1.5 before:rounded-full before:-translate-x-2/4 before:-translate-y-2/4 kt-scrollspy-active:before:bg-primary">
								</span>
								Contexto de Mercado
							</a>
							<a class="flex items-center rounded-lg pl-2.5 pr-2.5 py-2.5 gap-3.5 border border-transparent text-sm text-foreground hover:text-primary hover:font-medium kt-scrollspy-active:bg-secondary-active kt-scrollspy-active:text-primary kt-scrollspy-active:font-medium hover:rounded-lg" data-kt-scrollspy-anchor="true" href="#order_structure">
								<span class="flex w-1.5 relative before:absolute before:top-0 before:size-1.5 before:rounded-full before:-translate-x-2/4 before:-translate-y-2/4 kt-scrollspy-active:before:bg-primary">
								</span>
								Estructura
							</a>
							<a class="flex items-center rounded-lg pl-2.5 pr-2.5 py-2.5 gap-3.5 border border-transparent text-sm text-foreground hover:text-primary hover:font-medium kt-scrollspy-active:bg-secondary-active kt-scrollspy-active:text-primary kt-scrollspy-active:font-medium hover:rounded-lg" data-kt-scrollspy-anchor="true" href="#order_entry">
								<span class="flex w-1.5 relative before:absolute before:top-0 before:size-1.5 before:rounded-full before:-translate-x-2/4 before:-translate-y-2/4 kt-scrollspy-active:before:bg-primary">
								</span>
								Entrada
							</a>
							<a class="flex items-center rounded-lg pl-2.5 pr-2.5 py-2.5 gap-3.5 border border-transparent text-sm text-foreground hover:text-primary hover:font-medium kt-scrollspy-active:bg-secondary-active kt-scrollspy-active:text-primary kt-scrollspy-active:font-medium hover:rounded-lg" data-kt-scrollspy-anchor="true" href="#order_evaluation">
								<span class="flex w-1.5 relative before:absolute before:top-0 before:size-1.5 before:rounded-full before:-translate-x-2/4 before:-translate-y-2/4 kt-scrollspy-active:before:bg-primary">
								</span>
								Evaluación
							</a>
						</div>
					</div>
					<div class="flex flex-col">
						<div class="pl-6 pr-2.5 py-2.5 text-sm font-semibold text-mono">
							Trade
						</div>
						<div class="flex flex-col">
							<a class="flex items-center rounded-lg pl-2.5 pr-2.5 py-2.5 gap-3.5 border border-transparent text-sm text-foreground hover:text-primary hover:font-medium kt-scrollspy-active:bg-secondary-active kt-scrollspy-active:text-primary kt-scrollspy-active:font-medium hover:rounded-lg" data-kt-scrollspy-anchor="true" href="#order_trade">
								<span class="flex w-1.5 relative before:absolute before:top-0 before:size-1.5 before:rounded-full before:-translate-x-2/4 before:-translate-y-2/4 kt-scrollspy-active:before:bg-primary">
								</span>
								Órden y Costos
							</a>
						</div>
					</div>

				</div>
			</div>
		</div>
		<!-- End of Sidebar -->

		<!-- Content -->
		<div id="modal_orders_body" class="flex flex-col items-stretch grow gap-5 lg:gap-7.5" data-kt-scrollable="true" data-kt-scrollable-height="auto" data-kt-scrollable-offset="200px" id="modal_orders_content">

			<div class="kt-card pb-2.5">
				<div class="kt-card-header" id="order_general">
					<h3 class="kt-card-title">
						Información Básica
					</h3>
				</div>
				<div class="kt-card-content grid gap-5 pt-7.5">
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Categoría:</label>
							@Html.DropDownList("OrderCategoryId", CategoryItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Tipo de Cuenta:</label>
							@Html.DropDownList("OrderAccountTypeId", AccountTypeItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Instrumento:</label>
							@Html.DropDownList("OrderInstrumentId", InstrumentItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Fecha:</label>
							<input type="text" id="CreationDate" name="CreationDate" class="kt-input" />
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Tiempo:</label>
							<input type="text" id="Time" name="Time" class="kt-input" />
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Día:</label>
							@Html.DropDownList("DayId", DayItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
				</div>
			</div>

			<div class="kt-card pb-2.5">
				<div class="kt-card-header" id="order_context">
					<h3 class="kt-card-title">
						Contexto de Mercado
					</h3>
				</div>
				<div class="kt-card-content grid gap-5 pt-7.5">
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Etapa:</label>
							@Html.DropDownList("StageId", StageItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Dirección:</label>
							@Html.DropDownList("DirectionId", DirectionItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Ubicación en la estructura:</label>
							<select class="kt-select" data-kt-select="true" data-kt-select-enable-search="false" data-kt-select-search-placeholder="Buscar..." data-kt-select-placeholder="Selecciona uno..." data-kt-select-config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" id="LocationType" name="LocationType">
								<option value="1">SOPORTE</option>
								<option value="2">MEDIO</option>
								<option value="3">RESISTENCIA</option>
							</select>
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">¿Tu trade va con la tendencia?</label>
							<select class="kt-select" data-kt-select="true" data-kt-select-enable-search="false" data-kt-select-search-placeholder="Buscar..." data-kt-select-placeholder="Selecciona uno..." data-kt-select-config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" id="IsTrendAligned" name="IsTrendAligned">
								<option value="0">EN CONTRA</option>
								<option value="1">A FAVOR</option>
							</select>
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Zona de indecisión:</label>
							<select class="kt-select" data-kt-select="true" data-kt-select-enable-search="false" data-kt-select-search-placeholder="Buscar..." data-kt-select-placeholder="Selecciona uno..." data-kt-select-config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" id="IsPivotZone" name="IsPivotZone">
								<option value="0">NO</option>
								<option value="1">SI</option>
							</select>
						</div>
					</div>
				</div>
			</div>

			<div class="kt-card pb-2.5">
				<div class="kt-card-header" id="order_structure">
					<h3 class="kt-card-title">
						Estructura
					</h3>
				</div>
				<div class="kt-card-content grid gap-5 pt-7.5">
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Figura:</label>
							@Html.DropDownList("FigureId", FigureItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Frame:</label>
							@Html.DropDownList("OrderFrameId", FrameItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
				</div>
			</div>

			<div class="kt-card pb-2.5">
				<div class="kt-card-header" id="order_entry">
					<h3 class="kt-card-title">
						Entrada
					</h3>
				</div>
				<div class="kt-card-content grid gap-5 pt-7.5">
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Gatillo:</label>
							@Html.DropDownList("TriggerId", TriggerItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Tipo de confirmación:</label>
							<select class="kt-select" data-kt-select="true" data-kt-select-enable-search="false" data-kt-select-search-placeholder="Buscar..." data-kt-select-placeholder="Selecciona uno..." data-kt-select-config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" id="ConfirmationType" name="ConfirmationType">
								<option value="0">NONE</option>
								<option value="1">CONTINUATION BREAK</option>
								<option value="2">CONTINUATION RETEST</option>
								<option value="3">REVERSAL BREAK</option>
								<option value="4">REVERSAL RETEST</option>
							</select>
						</div>
					</div>
				</div>
			</div>

			<div class="kt-card pb-2.5">
				<div class="kt-card-header" id="order_evaluation">
					<h3 class="kt-card-title">
						Evaluación
					</h3>
				</div>
				<div class="kt-card-content grid gap-5 pt-7.5">
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Escenario:</label>
							@Html.DropDownList("SceneryId", SceneryItems, new
							{
								@class = "kt-select",
								data_kt_select = "true",
								data_kt_select_enable_search = "true",
								data_kt_select_search_placeholder = "Buscar...",
								data_kt_select_placeholder = "Selecciona uno...",
								data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
							})
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Grade:</label>
							<input type="text" class="kt-input" placeholder="Grade" disabled />
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Score:</label>
							<input type="text" class="kt-input" placeholder="Score" disabled />
						</div>
					</div>
				</div>
			</div>

			<div class="kt-card pb-2.5 mb-10">
				<div class="kt-card-header" id="order_trade">
					<h3 class="kt-card-title">
						Órden y Costos
					</h3>
				</div>
				<div class="kt-card-content grid gap-5 pt-7.5">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Tipo de Orden:</label>
								@Html.DropDownList("OrderTypeId", OrderTypeItems, new
								{
									@class = "kt-select",
									data_kt_select = "true",
									data_kt_select_enable_search = "true",
									data_kt_select_search_placeholder = "Buscar...",
									data_kt_select_placeholder = "Selecciona uno...",
									data_kt_select_config = "{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}"
								})
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Tipo de Trade:</label>
								<select class="kt-select" data-kt-select="true" data-kt-select-enable-search="true" data-kt-select-search-placeholder="Buscar..." data-kt-select-placeholder="Selecciona uno..." data-kt-select-config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" id="TradeTypeId" name="TradeTypeId">
									<option value=""></option>
									<option selected="selected" value="Buy">Compra</option>
								</select>
							</div>
						</div>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-4 gap-5">
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Cantidad:</label>
								<input type="text" id="Quantity" name="Quantity" class="kt-input" autocomplete="off" maxlength="18" value="0" />
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Precio:</label>
								<input type="text" id="Price" name="Price" class="kt-input" autocomplete="off" maxlength="18" value="0" />
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Comisión:</label>
								<input type="text" id="CommissionRate" name="CommissionRate" class="kt-input" autocomplete="off" maxlength="18" value="0.001" />
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Total:</label>
								<input type="text" id="Total" name="Total" class="kt-input" autocomplete="off" maxlength="18" value="0" />
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
		<!-- End of Content -->
	</div>

	<div class="kt-modal-footer gap-2.5 justify-end px-2 pb-0 pt-4">
		<button type="button" id="kt_modal_new_target_cancel" class="kt-btn kt-btn-secondary" data-kt-modal-dismiss="#modal_orders">Cancelar</button>
		<button type="button" class="kt-btn kt-btn-primary" id="submitButton">
			Guardar
		</button>
	</div>
</form>



<script>
	$(document).ready(function () {	
		InitSelect();

		let form = document.getElementById('kt_modal_stepper_form');
		const submitButton = document.getElementById('submitButton');

		const validator = FormValidation.formValidation(
			form,
			{
				fields: {
					'OrderCategoryId': {
						validators: {
							notEmpty: {
								message: 'La categoría es obligatoria'
							},
						}
					},
					'OrderAccountTypeId': {
						validators: {
							notEmpty: {
								message: 'El tipo de cuenta es obligatorio'
							},
						}
					},
					'OrderInstrumentId': {
						validators: {
							notEmpty: {
								message: 'El instrumento es obligatorio'
							},
						}
					},
					'DayId': {
						validators: {
							notEmpty: {
								message: 'El día es obligatorio'
							},
						}
					},
					'StageId': {
						validators: {
							notEmpty: {
								message: 'La etapa es obligatoria'
							},
						}
					},
					'FigureId': {
						validators: {
							notEmpty: {
								message: 'La figura es obligatoria'
							},
						}
					},
					'OrderFrameId': {
						validators: {
							notEmpty: {
								message: 'El frame es obligatorio'
							},
						}
					},
					'TriggerId': {
						validators: {
							notEmpty: {
								message: 'El gatillo es obligatorio'
							},
						}
					},
					'DirectionId': {
						validators: {
							notEmpty: {
								message: 'La dirección es obligatoria'
							},
						}
					},
					'SceneryId': {
						validators: {
							notEmpty: {
								message: 'El escenario es obligatorio'
							},
						}
					},
					'Total': {
						validators: {
							notEmpty: {
								message: 'El total es obligatorio'
							},
							callback: {
								message: 'El total debe ser mayor a 0',
								callback: function (input) {
									const cashValue = parseFloat(input.value.replace(/[^0-9.-]+/g, '')) || 0;
									return cashValue > 0;
								},
							},
						}
					},
				},
				plugins: {
					trigger: new FormValidation.plugins.Trigger(),
					submitButton: new FormValidation.plugins.SubmitButton(),
					message: new FormValidation.plugins.Message({
						clazz: 'text-red-500 text-sm mt-1',
						container: function (field, element) {
							return element.closest('.fv-row');
						}
					}),
				}
			}
		)
		.on('core.element.validated', function (e) {
			if (e.element.tagName === 'SELECT' && e.element.classList.contains('kt-select')) {
				const wrapper = e.element.closest('.kt-select');
				if (wrapper) {
					if (e.valid) {
						wrapper.classList.remove('border-destructive', 'ring-1', 'ring-red-500');
						wrapper.classList.add('border-green-500');
					} else {
						wrapper.classList.remove('border-green-500');
						wrapper.classList.add('border-destructive', 'ring-1', 'ring-red-500');
					}
				}
			} else {
				if (e.valid) {
					e.element.classList.remove('border-destructive', 'ring-1', 'ring-red-500');
					e.element.classList.add('border-green-500');
				} else {
					e.element.classList.remove('border-green-500');
					e.element.classList.add('border-destructive', 'ring-1', 'ring-red-500');
				}
			}
		});

		// Initialize all scrollspys
		KTScrollspy.init();

		// Initialzie pending scrollspys
		KTScrollspy.createInstances();

		// Get scrollspy object
		const scrollspyEl = document.querySelector('#modal_orders_content');
		const scrollspy = KTScrollspy.getInstance(scrollspyEl);

		 submitButton.addEventListener('click', function (e) {
				e.preventDefault();

				validator.validate().then(function (status) {

				if (status === 'Valid') {

					submitButton.disabled = true;

					AddOrder();
				}
			});
		});


		function AddOrder() {
			const parseBool = (val) => {
				if (typeof val === 'boolean') return val;
				if (typeof val === 'string') {
					const normalized = val.trim().toLowerCase();
					return ['true', '1', 'yes', 'on'].includes(normalized);
				}
				if (typeof val === 'number') {
					return val !== 0;
				}
				return false;
			};

			const getValue = (selector, parser = (val) => val, defaultValue = null) => {
				const element = document.querySelector(selector);
				return element ? parser(element.value || defaultValue) : defaultValue;
			};

			const data = {
				CategoryId: getValue('#OrderCategoryId', parseInt, 0),
				AccountTypeId: getValue('#OrderAccountTypeId', parseInt, 0),
				InstrumentsId: getValue('#OrderInstrumentId', parseInt, 0),
				CreationDate: getValue('#CreationDate'),
				Time: `${getValue('#Time', (val) => val, '00:00')}:00`,
				DayId: getValue('#DayId', parseInt, 0),
				StageId: getValue('#StageId', parseInt, 0),
				FigureId: getValue('#FigureId', parseInt, 0),
				FrameId: getValue('#OrderFrameId', parseInt, 0),
				TriggerId: getValue('#TriggerId', parseInt, 0),
				DirectionId: getValue('#DirectionId', parseInt, 0),
				SceneryId: getValue('#SceneryId', parseInt, 0),
				OrderTypeId: getValue('#OrderTypeId', String, ''),
				TradeTypeId: getValue('#TradeTypeId', String, ''),
				Quantity: getValue('#Quantity', parseFloat, 0),
				Price: getValue('#Price', parseFloat, 0),
				CommissionRate: getValue('#CommissionRate', parseFloat, 0),
				Total: getValue('#Total', parseFloat, 0),
				IsTrendAligned: getValue('#IsTrendAligned', parseBool, false),
				LocationType: getValue('#LocationType', parseInt, 0),
				IsPivotZone: getValue('#IsPivotZone', parseBool, false),
				ConfirmationType: getValue('#ConfirmationType', parseInt, 0),
			};

			var url = "@Url.Content("~/Orders/AddOrder")";
			fetch(url, {
				method: 'POST',
				body: JSON.stringify(data),
				headers: {
					'Content-Type': 'application/json',
				}
			}).then(res => res.json())
			.catch(error => console.error('Error:', error))
			.then((data) => {				
				submitButton.disabled = false;

				ShowNotification(data.notificationType, data.message);

				if(data.success)
				{
					const modalEl = document.querySelector('#modal_orders');
					const modal = KTModal.getInstance(modalEl);
					modal.hide();
					LoadDataTable();
				}
			});
		}

	});


	function InitSelect(){
		KTSelectHelper.clear('#OrderCategoryId');
		KTSelectHelper.clear('#OrderAccountTypeId');
		KTSelectHelper.clear('#OrderInstrumentId');
		KTSelectHelper.clear('#DayId');
		KTSelectHelper.clear('#StageId');
		KTSelectHelper.clear('#DirectionId');
		KTSelectHelper.clear('#IsTrendAligned');
		KTSelectHelper.clear('#IsPivotZone');
		KTSelectHelper.clear('#FigureId');
		KTSelectHelper.clear('#OrderFrameId');
		KTSelectHelper.clear('#TriggerId');
		KTSelectHelper.clear('#ConfirmationType');
		KTSelectHelper.clear('#SceneryId');
		KTSelectHelper.clear('#LocationType');
		KTSelectHelper.clear('#IsTrendAligned');
		KTSelectHelper.clear('#OrderTypeId');
		KTSelectHelper.clear('#TradeTypeId');

		
	}



	$("#Time").flatpickr({
		enableTime: true,
		noCalendar: true,
		dateFormat: "H:i",
		defaultDate: new Date(),
		minuteIncrement: 1,
		allowInput: true
	});

	$("#CreationDate").flatpickr({
		enableTime: false,
		noCalendar: false,
		locale: "es",
		defaultDate: new Date(),
		allowInput: true,
		onReady: function(selectedDates, dateStr, instance) {
			if (selectedDates.length > 0) {
				const selectedDate = selectedDates[0];
				const dayOfWeek = selectedDate.getDay();
				const value = dayOfWeek == 0 ? 7 : dayOfWeek;
				KTSelectHelper.setValue('#DayId', value.toString());
			}
		},
		onChange: function(selectedDates, dateStr, instance) {
			if (selectedDates.length > 0) {
				const selectedDate = selectedDates[0];
				const dayOfWeek = selectedDate.getDay();
				const value = dayOfWeek == 0 ? 7 : dayOfWeek;
				KTSelectHelper.setValue('#DayId', value.toString());
			}
		}
	});

	InputMaskHelper.decimal('#Quantity');
	InputMaskHelper.decimal('#Price');
	InputMaskHelper.decimal('#CommissionRate');
	InputMaskHelper.decimal('#Total');

</script>
