@{
	ViewData["Title"] = "Ordenes";

	var categoryItems = (List<SelectListItem>)ViewBag.CategoryItems;
	var accountTypeItems = (List<SelectListItem>)ViewBag.AccountTypeItems;
	var instrumentItems = (List<SelectListItem>)ViewBag.InstrumentItems;
	var frameItems = (List<SelectListItem>)ViewBag.FrameItems;
	var directionItems = (List<SelectListItem>)ViewBag.DirectionItems;

}

<!-- Header Container -->
<div class="kt-container-fixed">
	<div class="flex flex-wrap items-center lg:items-end justify-between gap-5 pb-7.5">
		<div class="flex flex-col justify-center gap-2">
			<h1 class="text-xl font-medium leading-none text-mono">
				Órdenes
			</h1>
			<div class="flex items-center gap-2 text-sm font-normal text-secondary-foreground">
				Consulta y administra las órdenes de trading registradas en el sistema.
			</div>
		</div>
		<div class="flex items-center gap-2.5">
			<a class="kt-btn kt-btn-outline" data-kt-drawer-toggle="#filter_drawer">
				<i class="ki-filled ki-setting-4"></i>
				Filtro
			</a>
			<a class="kt-btn kt-btn-primary" href="javascript:showModalForNew()">
				<i class="ki-filled ki-plus text-sm"></i>
				Nuevo
			</a>
		</div>
	</div>
</div>
<!-- End of Header Container -->

<!-- Container -->
<div class="kt-container-fixed">
	<div class="grid">
		<div class="kt-card kt-card-grid h-full min-w-full border border-white/5 shadow-2xs">
			<div class="kt-card-table kt-scrollable-x-auto">
				<table class="kt-table" data-kt-datatable-table="true" id="dtTable"></table>
			</div>
		</div>
	</div>
</div>
<!-- End of Container -->

<!--Filter Drawer-->
<div class="hidden kt-drawer kt-drawer-end card flex-col max-w-[90%] w-[450px] top-5 bottom-5 end-5 rounded-xl border border-border" data-kt-drawer="true" data-kt-drawer-container="body" id="filter_drawer">
	<div class="kt-card-header px-5">
		<h3 class="kt-card-title">
			Filtros Disponibles
		</h3>
		<button class="kt-btn kt-btn-sm kt-btn-icon kt-btn-ghost shrink-0" data-kt-drawer-dismiss="true">
			<i class="ki-filled ki-cross text-base">
			</i>
		</button>
	</div>
	<div class="kt-card-content space-y-5 p-5 kt-scrollable-y-auto">
		<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
			<label class="kt-form-label max-w-56">Categoría:</label>
			@Html.DropDownList("CategoryId", categoryItems, new { @class = "kt-select", 
			                                                      data_kt_select = "true", 
																  data_kt_select_enable_search = "true",
																  data_kt_select_search_placeholder = "Buscar...",
																  data_kt_select_placeholder="Selecciona uno...",
																  data_kt_select_config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" })
		</div>
		<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
			<label class="kt-form-label max-w-56">Tipo de Cuenta:</label>
			@Html.DropDownList("AccountTypeId", accountTypeItems, new { @class = "kt-select", 
			                                                      data_kt_select = "true", 
																  data_kt_select_enable_search = "true",
																  data_kt_select_search_placeholder = "Buscar...",
																  data_kt_select_placeholder="Selecciona uno...",
																  data_kt_select_config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" })
		</div>
		<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
			<label class="kt-form-label max-w-56">Instrumento:</label>
			@Html.DropDownList("InstrumentId", instrumentItems, new { @class = "kt-select", 
			                                                      data_kt_select = "true", 
																  data_kt_select_enable_search = "true",
																  data_kt_select_search_placeholder = "Buscar...",
																  data_kt_select_placeholder="Selecciona uno...",
																  data_kt_select_config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" })
		</div>
		<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
			<label class="kt-form-label max-w-56">Frame:</label>
			@Html.DropDownList("FrameId", frameItems, new { @class = "kt-select", 
			                                                      data_kt_select = "true", 
																  data_kt_select_enable_search = "true",
																  data_kt_select_search_placeholder = "Buscar...",
																  data_kt_select_placeholder="Selecciona uno...",
																  data_kt_select_config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" })
		</div>
		<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
			<label class="kt-form-label max-w-56">Dirección:</label>
			@Html.DropDownList("DirectionId", directionItems, new { @class = "kt-select", 
			                                                      data_kt_select = "true", 
																  data_kt_select_enable_search = "true",
																  data_kt_select_search_placeholder = "Buscar...",
																  data_kt_select_placeholder="Selecciona uno...",
																  data_kt_select_config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" })
		</div>
	</div>
	<div class="kt-card-footer p-5 flex gap-3">
		<a class="kt-btn kt-btn-outline" href="javascript:ClearFilterData()" data-kt-drawer-dismiss="true">
			Limpiar
		</a>
		<a class="kt-btn kt-btn-primary grow" href="javascript:SearchData()" data-kt-drawer-dismiss="true" id="btn_AplicarFiltro">
			Aplicar
		</a>
	</div>
</div>
<!--End of Filter Drawer-->
<!-- modal_orders -->
<div class="kt-container-fixed">
	<div class="kt-modal kt-modal-open:!flex" data-kt-modal="true" data-kt-modal-disable-scroll="false" id="modal_orders">
		<div class="kt-modal-content pt-7.5 my-[3%] w-full kt-container-fixed px-5 overflow-hidden" id="modal_orders_content">
            <div class="kt-modal-header p-0 border-0">
                <!-- Container -->
                <div class="kt-container-fixed">
                    <div class="flex flex-wrap items-center lg:items-end justify-between gap-5 pb-7.5">
                        <div class="flex items-center justify-between flex-wrap grow gap-5">
                            <div class="flex flex-col justify-center gap-2">
								<h1 class="text-xl font-semibold leading-none text-mono" id="title_modal">
                                    Settings - Modal
                                </h1>
								<div class="flex items-center gap-2 text-sm font-normal text-secondary-foreground" id="subtitle_modal">
                                    Dynamic,
                                    Focused Adjustment Interface
                                </div>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <a class="kt-btn kt-btn-outline" data-kt-modal-dismiss="true" href="#">
                                    Cerrar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- End of Container -->
            </div>
			<div class="kt-modal-body kt-scrollable-y py-0 mb-5 ps-6 pe-3 me-3" id="modal_orders_body">
			</div>
		</div>
</div>

</div>
<!-- End of modal_orders -->
@section scripts {
	<script>
		$(document).ready(function () {
			LoadDataTable();
		});

		function ClearFilterData() {
			KTSelectHelper.setValue('#CategoryId', 1);
			KTSelectHelper.clear('#AccountTypeId');
			KTSelectHelper.clear('#InstrumentId');
			KTSelectHelper.clear('#FrameId');
			KTSelectHelper.clear('#DirectionId');

			LoadDataTable();
		}

		function SearchData() {
			LoadDataTable();
		}

		function LoadDataTable() {
			 const categoryId = document.querySelector('#CategoryId').value || 0;
			 const accountTypeId = document.querySelector('#AccountTypeId').value || 0;
			 const instrumentId = document.querySelector('#InstrumentId').value || 0;
			 const frameId = document.querySelector('#FrameId').value || 0;
			 const directionId = document.querySelector('#DirectionId').value || 0;

			 var data = {
				  categoryId: categoryId,
				  accountTypeId: accountTypeId,
				  instrumentId: instrumentId,
				  frameId: frameId,
				  directionId: directionId
			 };

			if ($.fn.DataTable.isDataTable('#dtTable')) {
				$('#dtTable').DataTable().destroy();
			}

			$('#dtTable').DataTable({
				ajax: {
					url: "@Url.Content("~/Orders/JsonDataTable")",
					type: "POST",
					dataType: "json",
					data: data
				},
				columns: [
					{ name: "id", title: "#", data: "id", className: "min-w-[50px] w-[80px]" },
					{ name: "accountTypeName", title: "Tipo", data: "accountTypeName",orderable: false, className: "text-center min-w-[100px] w-[60px]", render: renderAccountTypeCode },
					{ name: "symbolName", title: "Instrumento", data: "symbolName",orderable: false, className: "text-center min-w-[100px] w-[150px]" },
					{ name: "creationDate", title: "Fecha", data: "creationDate",orderable: false, className: "text-center min-w-[70px] w-[100px]", render: function (data, type, row) {
								return type === 'display' || type === 'filter'
									? moment(data).format("DD/MM/YYYY") + ' ' + row.timeFormat
									: data;
							} },
					{ name: "stageName", title: "Setup", data: null, orderable: false, className: "text-center min-w-[150px] w-[250px]", render: renderSetupDT },
					{ name: "sceneryName", title: "Operación", data: null, orderable: false, className: "text-center min-w-[70px] w-[100px]", render: renderOperationDT},
					{ name: "sceneryName", title: "Resultado", data: null, orderable: false, className: "text-center min-w-[70px] w-[180px]", render: renderResultDT},
					{ name: "chart", title: "Chart", data: "chart",orderable: false, className: "text-center min-w-[50px] w-[60px]" },
					{ name: "statusId", title: "Estatus", data: "statusId",orderable: false, className: "text-center min-w-[60px] w-[60px]", render: renderOrderStatus },
					{ name: "task", title: "", data: "task", orderable: false, className: "text-center min-w-[80px] w-[60px]"  }
				],
				processing: true,
				serverSide: true,
				pageLength: 10,
				searching: false,
				info: true,
				language: {
					processing: "Procesando...",
					lengthMenu: "Mostrar _MENU_ registros",
					zeroRecords: "No se encontraron resultados",
					emptyTable: "Ningún dato disponible en esta tabla",
					info: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
					infoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
					infoFiltered: "(filtrado de un total de _MAX_ registros)",
					search: "",
					searchPlaceholder: "Buscar órdenes...",
					paginate: {
						first: "Primero",
						last: "Último",
						next: "›",
						previous: "‹"
					},
					aria: {
						orderable: "Activar para ordenar ascendente",
						orderableReverse: "Activar para ordenar descendente"
					}
				},
				layout: {
					topStart: [],
					topEnd: 'search',
					bottomStart: ['pageLength', 'info'],
					bottomEnd: 'paging'
				},
				initComplete: function () {
					const searchContainer = $('.dt-search');
					searchContainer.find('label').remove();
					searchContainer.html(`
						<div class="kt-input max-w-48 relative">
							<i class="ki-filled ki-magnifier text-sm text-secondary-foreground"></i>
							<input
								id="dt-search-0"
								type="text"
								class="w-full"
								placeholder="Buscar órdenes..."
							/>
						</div>
					`);
					searchContainer.find('input').on('keyup', function () {
						$('#dtTable').DataTable().search(this.value).draw();
					});
				},
				drawCallback: function () {
					KTMenu.createInstances();
				},
			});
		}

		function showModal(urlContent, title, subtitle) {
			fetch(urlContent).then((response) => {
				return response.text();
			}).then((data) => {
				$("#modal_orders_body").html(data);
				$('#title_modal').html(title);
				$('#subtitle_modal').html(subtitle);

				const modalEl = KTDom.getElement('#modal_orders');
				const modal = KTModal.getInstance(modalEl);
				modal.show();
			});
		}

		function showModalForNew() {
			urlContentModal = "@Url.Content("~/Orders/New")";
			showModal(urlContentModal, 'Nueva orden','Completa la información para registrar una nueva orden');
		}

		function showModalForUpdate(id) {
			urlContentModal = "@Url.Content("~/Orders/Edit/?id=")" + id;
			showModal(urlContentModal, 'Editar orden','Modifica los parámetros de la orden seleccionada')
		}

		function toDeleteOrder(id) {
			$("#confirmButtonYes").bind('click', () => {
				$("#confirmButtonYes").unbind('click');
				const confirmEl = document.querySelector('#confirmDialog');
				const confirmModal = KTModal.getInstance(confirmEl);
				confirmModal.hide();
				processingDelete(id);
			});
			$('#confirmDialogContent').html('¿Está seguro de que desea eliminar la orden? Esta acción no se puede deshacer.')
			$('#confirmTitle').html('Eliminar la orden');

			const confirmEl = document.querySelector('#confirmDialog');
			const confirmModal = KTModal.getInstance(confirmEl);
			confirmModal.show();
		}

		function processingDelete(id) {
			var urlConfirmModal = "@Url.Content("~/Orders/Delete")";
			fetch(urlConfirmModal, {
				method: 'POST',
				body: JSON.stringify(id),
				headers: {
					'Content-Type': 'application/json'
				}
			}).then(res => res.text())
				.catch(error => console.error('Error:', error))
				.then((data) => {
					if (data === 'true') {
						var urlIndex = "@Html.Raw(Url.Action("Index", "Orders", new { message = "La orden ha sido eliminada con éxito.", notification = "Success" }))";
					} else {
						var urlIndex = "@Html.Raw(Url.Action("Index", "Orders", new { message = "Ocurrio un problema", notification = Web.Models.Enums.NotificationType.Error }))";
					}
				   
					window.location.href = urlIndex;
				});
		}

		function showModalForClose(id) {
			urlContentModal = "@Url.Content("~/Orders/Close/?id=")" + id;
			showModal(urlContentModal, 'Cerrar orden','Registra el resultado de cierre de la operación');
		}
	</script>
}
