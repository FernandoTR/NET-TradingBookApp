@model Web.Models.OrdersSellViewModel

@{
	Layout = null;

	var OrderTypeItems = (List<SelectListItem>)ViewBag.OrderTypeItems;
}

<form id="kt_modal_stepper_form" novalidate="novalidate">
	<div class="flex grow gap-5 lg:gap-7.5">

		<!-- Sidebar -->
		<div class="hidden lg:block w-[230px] shrink-0">
			<div class="w-[230px] fixed z-10 kt-scrollable-y-auto" data-kt-scrollable="true" data-kt-scrollable-height="auto" data-kt-scrollable-offset="225px" data-kt-scrollable-wrappers="#modal_orders_content">
				<div class="flex flex-col grow relative before:absolute before:left-[11px] before:top-0 before:bottom-0 before:border-l before:border-border" data-kt-scrollspy="true" data-kt-scrollspy-offset="110px" data-kt-scrollspy-target="#modal_orders_body">

					<div class="flex flex-col">
						<div class="pl-6 pr-2.5 py-2.5 text-sm font-semibold text-mono">
							Cierre
						</div>
						<div class="flex flex-col">
							<a class="flex items-center rounded-lg pl-2.5 pr-2.5 py-2.5 gap-3.5 active border border-transparent text-sm text-foreground hover:text-primary hover:font-medium kt-scrollspy-active:bg-secondary-active kt-scrollspy-active:text-primary kt-scrollspy-active:font-medium hover:rounded-lg" data-kt-scrollspy-anchor="true" href="#order_close_general">
								<span class="flex w-1.5 relative before:absolute before:top-0 before:size-1.5 before:rounded-full before:-translate-x-2/4 before:-translate-y-2/4 kt-scrollspy-active:before:bg-primary">
								</span>
								General
							</a>
							<a class="flex items-center rounded-lg pl-2.5 pr-2.5 py-2.5 gap-3.5 border border-transparent text-sm text-foreground hover:text-primary hover:font-medium kt-scrollspy-active:bg-secondary-active kt-scrollspy-active:text-primary kt-scrollspy-active:font-medium hover:rounded-lg" data-kt-scrollspy-anchor="true" href="#order_close_sale">
								<span class="flex w-1.5 relative before:absolute before:top-0 before:size-1.5 before:rounded-full before:-translate-x-2/4 before:-translate-y-2/4 kt-scrollspy-active:before:bg-primary">
								</span>
								Venta
							</a>
						</div>
					</div>

				</div>
			</div>
		</div>
		<!-- End of Sidebar -->

		<!-- Content -->
		<div id="modal_orders_body" class="flex flex-col items-stretch grow gap-5 lg:gap-7.5" data-kt-scrollable="true" data-kt-scrollable-height="auto" data-kt-scrollable-offset="200px" id="modal_orders_content">

			<div class="kt-card pb-2.5">
				<div class="kt-card-header" id="order_close_general">
					<h3 class="kt-card-title">
						General
					</h3>
				</div>
				<div class="kt-card-content grid gap-5 pt-7.5">

					<div class="flex items-center gap-5 flex-wrap mt-3">
						<label class="flex items-center gap-2">
							<input class="kt-checkbox" type="checkbox" value="1" id="SL" name="SL" />
							<span class="font-semibold text-sm">SL</span>
						</label>
						<label class="flex items-center gap-2">
							<input class="kt-checkbox" type="checkbox" value="1" id="TP1" name="TP1" />
							<span class="font-semibold text-sm">TP1</span>
						</label>
						<label class="flex items-center gap-2">
							<input class="kt-checkbox" type="checkbox" value="1" id="TP2" name="TP2" />
							<span class="font-semibold text-sm">TP2</span>
						</label>
						<label class="flex items-center gap-2">
							<input class="kt-checkbox" type="checkbox" value="1" id="TP3" name="TP3" />
							<span class="font-semibold text-sm">TP3</span>
						</label>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Target:</label>
								<input type="text" id="Target" name="Target" class="kt-input" autocomplete="off" maxlength="18" value="0" />
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Chart:</label>
								<input type="text" id="Chart" name="Chart" class="kt-input" autocomplete="off" />
							</div>
						</div>
					</div>

					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Comentarios:</label>
							<textarea id="Comments" name="Comments" class="kt-input" autocomplete="off" rows="3"></textarea>
						</div>
					</div>

				</div>
			</div>

			<div class="kt-card pb-2.5 mb-10">
				<div class="kt-card-header" id="order_close_sale">
					<h3 class="kt-card-title">
						Venta
					</h3>
				</div>
				<div class="kt-card-content grid gap-5 pt-7.5">

					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Tipo de Orden:</label>
								@Html.DropDownList("OrderTypeId", OrderTypeItems, new { @class = "kt-select",
									data_kt_select = "true",
									data_kt_select_enable_search = "true",
									data_kt_select_search_placeholder = "Buscar...",
									data_kt_select_placeholder="Selecciona uno...",
									data_kt_select_config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" })
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Tipo de Trade:</label>
								<select class="kt-select" data-kt-select="true" data-kt-select-enable-search="true" data-kt-select-search-placeholder="Buscar..." data-kt-select-placeholder="Selecciona uno..." data-kt-select-config="{''optionsClass'': ''kt-scrollable overflow-auto max-h-[250px]''}" id="TradeTypeId" name="TradeTypeId">
									<option value=""></option>
									<option selected="selected" value="Sell">Venta</option>
								</select>
							</div>
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-4 gap-5">
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Cantidad:</label>
								<input type="text" id="Quantity" name="Quantity" class="kt-input" autocomplete="off" maxlength="18" value="0" />
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Precio:</label>
								<input type="text" id="Price" name="Price" class="kt-input" autocomplete="off" maxlength="18" value="0" />
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Comisión:</label>
								<input type="text" id="CommissionRate" name="CommissionRate" class="kt-input" autocomplete="off" maxlength="18" value="0.001" />
							</div>
						</div>
						<div class="w-full fv-row">
							<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
								<label class="kt-form-label max-w-56">Total:</label>
								<input type="text" id="Total" name="Total" class="kt-input" autocomplete="off" maxlength="18" value="0" />
							</div>
						</div>
					</div>

				</div>
			</div>

		</div>
		<!-- End of Content -->
	</div>

	<div class="kt-modal-footer gap-2.5 justify-end px-2 pb-0 pt-4">
		<button type="button" id="kt_modal_new_target_cancel" class="kt-btn kt-btn-secondary" data-kt-modal-dismiss="#modal_orders">Cancelar</button>
		<button type="button" class="kt-btn kt-btn-primary" id="submitButton">
			Guardar
		</button>
	</div>

	<div hidden>
		@Html.HiddenFor(d => d.Id)
	</div>
</form>


<script>
	$(document).ready(function () {
		InitSelect();

		let form = document.getElementById('kt_modal_stepper_form');
		const submitButton = document.getElementById('submitButton');

		const validator = FormValidation.formValidation(
			form,
			{
				fields: {
					'Chart': {
						validators: {
							notEmpty: {
								message: 'El chart es obligatorio'
							},
						}
					},
					'Total': {
						validators: {
							notEmpty: {
								message: 'El total es obligatorio'
							},
							callback: {
								message: 'El total debe ser mayor a 0',
								callback: function (input) {
									const cashValue = parseFloat(input.value.replace(/[^0-9.-]+/g, '')) || 0;
									return cashValue > 0;
								},
							},
						}
					},
				},
				plugins: {
					trigger: new FormValidation.plugins.Trigger(),
					submitButton: new FormValidation.plugins.SubmitButton(),
					message: new FormValidation.plugins.Message({
						clazz: 'text-red-500 text-sm mt-1',
						container: function (field, element) {
							return element.closest('.fv-row');
						}
					}),
				}
			}
		)
		.on('core.element.validated', function (e) {
			if (e.element.tagName === 'SELECT' && e.element.classList.contains('kt-select')) {
				const wrapper = e.element.closest('.kt-select');
				if (wrapper) {
					if (e.valid) {
						wrapper.classList.remove('border-destructive', 'ring-1', 'ring-red-500');
						wrapper.classList.add('border-green-500');
					} else {
						wrapper.classList.remove('border-green-500');
						wrapper.classList.add('border-destructive', 'ring-1', 'ring-red-500');
					}
				}
			} else {
				if (e.valid) {
					e.element.classList.remove('border-destructive', 'ring-1', 'ring-red-500');
					e.element.classList.add('border-green-500');
				} else {
					e.element.classList.remove('border-green-500');
					e.element.classList.add('border-destructive', 'ring-1', 'ring-red-500');
				}
			}
		});

		KTScrollspy.init();
		KTScrollspy.createInstances();

		const scrollspyEl = document.querySelector('#modal_orders_content');
		const scrollspy = KTScrollspy.getInstance(scrollspyEl);

		submitButton.addEventListener("click", function (e) {
			e.preventDefault();

			validator.validate().then(function (status) {
				if (status == 'Valid') {
					submitButton.setAttribute('data-kt-indicator', 'on');
					submitButton.disabled = true;
					CloseOrder();
				}
			});
		});

		function CloseOrder() {
			const getValue = (selector, parser = (val) => val, defaultValue = null) => {
				const element = document.querySelector(selector);

				if (!element) return defaultValue;

				if (element.type === 'checkbox') {
					return element.checked;
				}

				const value = element.value || defaultValue;
				return parser(value);
			};

			const data = {
				Id: getValue('#Id', parseInt, 0),
				SL: getValue('#SL', Boolean, false),
				TP1: getValue('#TP1', Boolean, false),
				TP2: getValue('#TP2', Boolean, false),
				TP3: getValue('#TP3', Boolean, false),
				Target: getValue('#Target', String, ''),
				Chart: getValue('#Chart', String, ''),
				Comments: getValue('#Comments', String, ''),
				OrderTypeId: getValue('#OrderTypeId', String, ''),
				TradeTypeId: getValue('#TradeTypeId', String, ''),
				Quantity: getValue('#Quantity', parseFloat, 0),
				Price: getValue('#Price', parseFloat, 0),
				CommissionRate: getValue('#CommissionRate', parseFloat, 0),
				Total: getValue('#Total', parseFloat, 0),
			};

			var url = "@Url.Content("~/Orders/CloseOrder")";
			fetch(url, {
				method: 'POST',
				body: JSON.stringify(data),
				headers: {
					'Content-Type': 'application/json',
				}
			}).then(res => res.json())
			.catch(error => console.error('Error:', error))
			.then((data) => {
				submitButton.setAttribute('data-kt-indicator', 'off');
				submitButton.disabled = false;

				ShowNotification(data.notificationType, data.message);

				if(data.success)
				{
					const modalEl = document.querySelector('#modal_orders');
					const modal = KTModal.getInstance(modalEl);
					modal.hide();
					LoadDataTable();
				}
			});
		}

		const config = {
			SL: { uncheck: ["TP1", "TP2", "TP3"], message: "La operación se efectuó con una pérdida del 0,00%." },
			TP1: { uncheck: ["SL", "TP2", "TP3"], message: "La operación se realizó con un rendimiento del 0.00%." },
			TP2: { uncheck: ["SL", "TP3"], check: ["TP1"], message: "La operación se realizó con un rendimiento del 0.00%." },
			TP3: { uncheck: ["SL"], check: ["TP1", "TP2"], message: "La operación se realizó con un rendimiento del 0.00%." }
		};

		Object.keys(config).forEach(id => {
			document.getElementById(id).addEventListener("change", function () {
				if (this.checked) {
					const { uncheck = [], check = [], message } = config[id];

					uncheck.forEach(uncheckId => $('#' + uncheckId).prop('checked', false));
					check.forEach(checkId => $('#' + checkId).prop('checked', true));
					$('#Comments').text(message);
				}
			});
		});

	});

	function InitSelect(){
		KTSelectHelper.clear('#OrderTypeId');
		KTSelectHelper.clear('#TradeTypeId');
	}

	InputMaskHelper.decimal('#Target');
	InputMaskHelper.decimal('#Quantity');
	InputMaskHelper.decimal('#Price');
	InputMaskHelper.decimal('#CommissionRate');
	InputMaskHelper.decimal('#Total');

</script>
