@model Web.Models.UsersListViewModel

@{
    Layout = null;
}


@using (Html.BeginForm("Update", "Users", FormMethod.Post, new { id = "frmdata" }))
{
    @Html.AntiForgeryToken()

    <div class="kt-card-content grid gap-5">
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.Label("Usuario", "Usuario", new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.Name, new { disabled = "disabled", @class = "kt-input" })
            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="kt-card shadow-none p-4 mb-5" bis_skin_checked="1">
                <div class="flex flex-wrap gap-2.5" bis_skin_checked="1">
                    <i class="ki-filled ki-information-4 text-lg text-primary">
                    </i>
                    <div class="flex flex-col gap-5 grow" bis_skin_checked="1">
                        <div class="flex flex-wrap items-center justify-between" bis_skin_checked="1">
                            <div class="flex flex-col gap-0.5" bis_skin_checked="1">
                                <span class="text-base font-medium text-mono cursor-pointer hover:text-primary mb-px">
                                    Seleccione los perfiles para el usuario
                                </span>
                                <span class="text-xs text-secondary-foreground">
                                    Debe seleccionar al menos un perfil para el usuario.
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @for (int i = 0; i < Model.listAccess.Count; i++)
            {
                <div class="flex items-center gap-2.5">
                    @Html.HiddenFor(x => Model.listAccess[i].RolId)
                    @Html.HiddenFor(x => Model.listAccess[i].Name)
                    @Html.CheckBoxFor(x => Model.listAccess[i].IsSelected, new { @class = "form-check-input", id = "permissions" })
                    @Html.LabelFor(x => Model.listAccess[i].IsSelected, Model.listAccess[i].Name, new { @class = "text-gray-800 text-hover-primary fw-bold fs-6" })
                </div>
            }
        </div>
        <!--end::Input group-->
    </div>

    <!--begin::Actions-->
    <div class="kt-modal-footer gap-2.5 justify-end">
        <button type="button" id="kt_modal_new_target_cancel" class="kt-btn kt-btn-secondary" data-kt-modal-dismiss="#vModal">Cancel</button>
        <button type="button" id="btnSave" class="kt-btn kt-btn-primary">Guardar</button>
    </div>
    <!--end::Actions-->
    <div hidden>
        @Html.HiddenFor(d => d.Id)
    </div>
}


<script>

    $(document).ready(function () {
        const form = document.getElementById('frmdata');
        const submitButton = document.getElementById('btnSave');

        const validator = FormValidation.formValidation(form,
            {
                fields: {
                    'permissions': {
                        validators: {
                            callback: {
                                message: 'Debe seleccionar al menos un Permiso.',
                                callback: function (value, validator, $field) {
                                    return form.querySelectorAll('input[type=checkbox]:checked').length > 0;
                                }
                            }
                        }
                    },
                },

                plugins: {
                    trigger:
                        new FormValidation.plugins.Trigger(),
                    submitButton:
                        new FormValidation.plugins.SubmitButton(),
                    message:
                        new FormValidation.plugins.Message({
                            clazz: 'text-red-500 text-sm mt-1',
                            container: function (field, element) {
                                return element.closest('.fv-row');
                            }
                        }),
                }
            }
        )
        .on('core.element.validated', function (e) {
            if (e.element.type === 'checkbox') {
                return;
            }
            if (e.valid) {
                e.element.classList.remove('border-destructive', 'ring-1', 'ring-red-500');
                e.element.classList.add('border-green-500');
            } else {
                e.element.classList.remove('border-green-500');
                e.element.classList.add('border-destructive', 'ring-1', 'ring-red-500');
            }
        });

        submitButton.addEventListener('click', function (e) {
            e.preventDefault();

            validator.validate().then(function (status) {
                if (status === 'Valid') {
                    submitButton.disabled = true;
                    form.submit();
                }
            });
        });

    });
</script>
