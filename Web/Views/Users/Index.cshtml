@model List<Web.Models.UsersListViewModel>

@{
    ViewBag.Title = "Usuarios";
}

<!-- Header Container -->
<div class="kt-container-fixed">
	<div class="flex flex-wrap items-center lg:items-end justify-between gap-5 pb-7.5">
		<div class="flex flex-col justify-center gap-2">
			<h1 class="text-xl font-medium leading-none text-mono">
				Usuarios
			</h1>
			<div class="flex items-center gap-2 text-sm font-normal text-secondary-foreground">
				Gestión de usuarios del sistema.
			</div>
		</div>
		<div class="flex items-center gap-2.5">
		</div>
	</div>
</div>
<!-- End of Header Container -->
<!-- Container -->
<div class="kt-container-fixed">
	<div class="grid" bis_skin_checked="1">
		<div class="kt-card kt-card-grid h-full min-w-full border border-white/5 shadow-2xs" bis_skin_checked="1">
			<div class="kt-card-table kt-scrollable-x-auto" bis_skin_checked="1">
				<table class="kt-table" data-kt-datatable-table="true" id="dtTable"></table>
			</div>
		</div>
	</div>
</div>
<!-- End of Container -->


@section scripts {
	<script src="~/Template/assets/vendors/datatables-net/dataTables.min.js"></script>
	<script>
		$(document).ready(function () {

			// Función para cargar datos en la tabla
			function loadTableDate() {

				// Evita reinicialización incorrecta
				if ($.fn.DataTable.isDataTable('#dtTable')) {
					$('#dtTable').DataTable().destroy();
				}

				$('#dtTable').DataTable({
					ajax: {
						url: "@Url.Content("~/Users/JsonDataTable")",
						type: "POST",
						dataType: "json"
					},
					columns: [
						{
							name: "email",
							title: "Usuario",
							data: "email",
							className: "min-w-[100px]"
						},
						{
							name: "name",
							title: "Rol",
							data: "name",
							className: "text-center min-w-[100px]"
						},
						{
							name: "status",
							title: "Estatus",
							data: "status",
							className: "text-center min-w-[100px] w-[100px]",
							orderable: false,
							render: renderStatusEmployee
						},
						{
							name: "emailConfirmed",
							title: "Correo Confirmado",
							data: "emailConfirmed",
							className: "text-center min-w-[100px] w-[100px]",
							orderable: false,
							render: renderTrueFalse
						},
						{
							name: "resetFlag",
							title: "Bandera Reseteo",
							data: "resetFlag",
							className: "text-center min-w-[100px] w-[100px]",
							orderable: false,
							render: renderFlag
						},
						
						
						{
							name: "accesFailedCount",
							title: "Accesos Erroneos",
							data: "accesFailedCount",
							className: "text-center min-w-[100px] w-[80px]",
							orderable: false,
						},
						{
							name: "passwordEndDate",
							title: "Fecha Fin Contraseña",
							data: "passwordEndDate",
							className: "text-center min-w-[80px] w-[80px]",
							orderable: false,
							render: function (data, type, row) {
								return type === 'display' || type === 'filter'
									? moment(data).format("DD/MM/YYYY HH:mm:ss")
									: data;
							}
						},
						{
							name: "task",
							title: "",
							data: "task",
							orderable: false,
							className: "text-center min-w-[60px] w-[60px]"
						}
					],
					processing: true,
					serverSide: true,
					pageLength: 10,
					searching: true,
					language: {
						processing: "Procesando...",
						lengthMenu: "Mostrar _MENU_ registros",
						zeroRecords: "No se encontraron resultados",
						emptyTable: "Ningún dato disponible en esta tabla",
						info: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
						infoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
						infoFiltered: "(filtrado de un total de _MAX_ registros)",
						search: "",
						searchPlaceholder: "Buscar usuarios...",
						paginate: {
							first: "Primero",
							last: "Último",
							next: "›",
							previous: "‹"
						},
						aria: {
							orderable: "Activar para ordenar ascendente",
							orderableReverse: "Activar para ordenar descendente"
						}
					},
					layout: {
						topStart: [],
						topEnd: 'search',
						bottomStart: ['pageLength', 'info'],
						bottomEnd: 'paging'
					},
					initComplete: function () {

						const searchContainer = $('.dt-search');

						searchContainer.find('label').remove();

						searchContainer.html(`
								<div class="kt-input max-w-48 relative">
								<i class="ki-filled ki-magnifier text-sm text-secondary-foreground"></i>
								<input
									id="dt-search-0"
									type="text"
									class="w-full "
									placeholder="Buscar usuarios..."
								/>
								</div>
								`);

						searchContainer.find('input').on('keyup', function () {
							$('#dtTable').DataTable().search(this.value).draw();
						});

					},
					drawCallback: function () {
						KTMenu.createInstances();
					}
				});
			}

			// Recargar datos de la tabla
			loadTableDate();
		});


		function showModal(urlContent, title, subtitle) {

			fetch(urlContent).then((response) => {
				return response.text();
			}).then((data) => {
				$("#contentvModal").html(data);
				$('#title-modal').html(title);
				$('#subtitle-modal').html(subtitle);

				const modalEl = document.querySelector('#vModal');
				const modal = KTModal.getInstance(modalEl);
				modal.show();
			});
		}


		function showModalForUpdate(id) {
			urlContentModal = "@Url.Content("~/Users/Edit/?id=")" + id;
			showModal(urlContentModal, 'Editar Usuario','');
		}


		function showModalForModifyRoles(id) {
			urlContentModal = "@Url.Content("~/Users/Edit/?id=")" + id;
			showModal(urlContentModal, 'Modificar Perfil Para el Usuario','');
		}


		function toDeleteUser(id) {
			const modalEl = document.querySelector('#confirmDialog');
			const modal = KTModal.getInstance(modalEl);

			$("#confirmButtonYes").bind('click', () => {
				$("#confirmButtonYes").unbind('click');
				modal.hide();
				processingDelete(id);
			});
			$('#confirmDialogContent').html('¿Esta usted seguro de eliminar/activar Usuario?')
			$('#confirmTitle').html('Cambiar estatus del usuario');
			modal.show();
		}

		function processingDelete(id) {
			console.log("id eliminar" + id);
			var urlConfirmModal = "@Url.Content("~/Users/Delete")";
			fetch(urlConfirmModal, {
				method: 'POST',
				body: JSON.stringify(id),
				headers: {
					'Content-Type': 'application/json'
				}
			}).then(res => res.text())
				.catch(error => console.error('Error:', error))
				.then((data) => {
					if (data === 'true') {
						var urlIndex = "@Html.Raw(Url.Action("Index", "Users", new { message = "Se actualizo el estatus del usuario", notification = "Success" }))";
					} else {
						var urlIndex = "@Html.Raw(Url.Action("Index", "Users", new { message = "Ocurrio un problema", notification = Web.Models.Enums.NotificationType.Error }))";
					}

					window.location.href = urlIndex;
				});
		}

	</script>


}
