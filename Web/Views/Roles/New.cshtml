@model Web.Models.RolesViewModel

@{
    Layout = null;
}


@using (Html.BeginForm("Save", "Roles", FormMethod.Post, new { id = "frmdata" }))
{
    @Html.AntiForgeryToken()
    <div class="kt-card-content grid gap-5">
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.NameRoles, new { @class = "kt-form-label max-w-56" })
                @Html.TextBoxFor(d => d.NameRoles, new { @class = "kt-input" })

            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full">
            <label class="kt-form-label">Permisos</label>
            <hr />
            <div id="CheckboxTree"></div>
        </div>
        <!--end::Input group-->
    </div>

    <!--begin::Actions-->
    <div class="kt-modal-footer gap-2.5 justify-end">
        <button type="button" id="kt_modal_new_target_cancel" class="kt-btn kt-btn-secondary" data-kt-modal-dismiss="#vModal">Cancelar</button>
        <button type="button" id="btnSave" class="kt-btn kt-btn-primary">Guardar</button>
    </div>
    <!--end::Actions-->
    @Html.HiddenFor(d => d.RolId)
    @Html.HiddenFor(x => x.listAccessString)
}




<script>

    $(document).ready(function () {
            const form = document.getElementById('frmdata');
            const submitButton = document.getElementById('btnSave');

            const validator = FormValidation.formValidation(form,
                            {
                                fields: {
                                            'NameRoles': {
                                                validators: {
                                                    notEmpty: {
                                                        message: 'El nombre del rol es obligatorio'
                                                    },
                                                }
                                            },
                                        },

                                plugins: {
                                        trigger:
                                                new FormValidation.plugins.Trigger(),
                                        submitButton:
                                                new FormValidation.plugins.SubmitButton(),
                                        message:
                                                new FormValidation.plugins.Message({
                                                    clazz: 'text-red-500 text-sm mt-1',
                                                    container: function (field, element) {
                                                    return element.closest('.fv-row');
                                                    }
                                                }),
                                }
                            }
            )
            .on('core.element.validated', function (e) {

                    if (e.valid) {
                        e.element.classList.remove('border-destructive','ring-1','ring-red-500');
                        e.element.classList.add('border-green-500');
                    } else {
                        e.element.classList.remove('border-green-500');
                        e.element.classList.add('border-destructive','ring-1','ring-red-500');
                    }
            });

        submitButton.addEventListener('click', function (e) {
                e.preventDefault();

                validator.validate().then(function (status) {

                if (status === 'Valid') {

                    submitButton.disabled = true;

                    $('#listAccessString').val($('#CheckboxTree').jstree('get_selected'));
                    form.submit();
                }
            });
        });


            $('#CheckboxTree').jstree("destroy").empty();
            $('#CheckboxTree').jstree({
                'core': {
                    'data': {
                        "url": "/Roles/GetPermissions?rolId=" + document.getElementById("RolId").value,
                        "dataType": "json",
                        "data": function (node) {
                            return {
                                'rolId': node.rolId
                            };
                        }
                    },
                    'themes': {
                        'name': 'default',
                        'responsive': true,
                        'icons': false
                    }
                },
                'plugins': ["checkbox"],
                'checkbox': {
                    "keep_selected_style": false,
                    "three_state": false,
                    "cascade": "up down"
                },
            });

         });


</script>
