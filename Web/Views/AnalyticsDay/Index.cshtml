@{
	ViewData["Title"] = "Días";

	var categoryItems = (List<SelectListItem>)ViewBag.CategoryItems;
	var accountTypeItems = (List<SelectListItem>)ViewBag.AccountTypeItems;
	var instrumentItems = (List<SelectListItem>)ViewBag.InstrumentItems;
	var frameItems = (List<SelectListItem>)ViewBag.FrameItems;
	var directionItems = (List<SelectListItem>)ViewBag.DirectionItems;
}

<!--begin::Header container-->
<div class="kt-container-fixed">
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <h1 class="text-gray-900 fw-bold fs-2 my-0">Análisis Diario</h1>
            <p class="text-gray-500 fw-semibold fs-7 my-0">Consulta el rendimiento de los días configurados en el sistema.</p>
        </div>
        <button class="kt-btn kt-btn-outline" data-kt-drawer-toggle="#filter_drawer">
            <i class="ki-duotone ki-filter fs-6 me-1"><span class="path1"></span><span class="path2"></span></i>Filtro
        </button>
    </div>
</div>
<!--end::Header container-->

<!--begin::Content-->
<div class="kt-container-fixed">
    <!--begin::Card-->
    <div class="kt-card kt-card-grid">
        <!--begin::Card table-->
        <div class="kt-card-table kt-scrollable-x-auto">
            <!--begin::Table-->
            <table id="dtTable" class="kt-table" data-kt-datatable-table="true"></table>
            <!--end::Table-->
        </div>
        <!--end::Card table-->
    </div>
    <!--end::Card-->
</div>
<!--end::Content-->

<!--begin::Drawer-->
<div id="filter_drawer" class="kt-drawer kt-drawer-end" data-kt-drawer="true" data-kt-drawer-activate="true" data-kt-drawer-toggle="#filter_drawer" data-kt-drawer-close="#filter_drawer_close" data-kt-drawer-width="350px">
    <div class="kt-card kt-card-flush h-full">
        <div class="kt-card-header">
            <h3 class="kt-card-title">Filtros Disponibles</h3>
            <button id="filter_drawer_close" class="kt-btn kt-btn-icon kt-btn-sm kt-btn-active-light-primary">
                <i class="ki-duotone ki-cross fs-2"></i>
            </button>
        </div>
        <div class="kt-card-content kt-scrollable-y-auto px-7 py-5">
            <div class="mb-5">
                <label class="kt-form-label">Categoría:</label>
                @Html.DropDownList("CategoryId", categoryItems, new { @class = "kt-select", data_kt_select = "true", data_kt_select_enable_search = "true", data_kt_select_placeholder = "Selecciona uno...", data_kt_select_config = "{'optionsClass': 'kt-scrollable overflow-auto max-h-[250px]'}" })
            </div>
            <div class="mb-5">
                <label class="kt-form-label">Tipo de Cuenta:</label>
                @Html.DropDownList("AccountTypeId", accountTypeItems, new { @class = "kt-select", data_kt_select = "true", data_kt_select_enable_search = "true", data_kt_select_placeholder = "Selecciona uno...", data_kt_select_config = "{'optionsClass': 'kt-scrollable overflow-auto max-h-[250px]'}" })
            </div>
            <div class="mb-5">
                <label class="kt-form-label">Instrumento:</label>
                @Html.DropDownList("InstrumentId", instrumentItems, new { @class = "kt-select", data_kt_select = "true", data_kt_select_enable_search = "true", data_kt_select_placeholder = "Selecciona uno...", data_kt_select_config = "{'optionsClass': 'kt-scrollable overflow-auto max-h-[250px]'}" })
            </div>
            <div class="mb-5">
                <label class="kt-form-label">Frame:</label>
                @Html.DropDownList("FrameId", frameItems, new { @class = "kt-select", data_kt_select = "true", data_kt_select_enable_search = "true", data_kt_select_placeholder = "Selecciona uno...", data_kt_select_config = "{'optionsClass': 'kt-scrollable overflow-auto max-h-[250px]'}" })
            </div>
            <div class="mb-5">
                <label class="kt-form-label">Dirección:</label>
                @Html.DropDownList("DirectionId", directionItems, new { @class = "kt-select", data_kt_select = "true", data_kt_select_enable_search = "true", data_kt_select_placeholder = "Selecciona uno...", data_kt_select_config = "{'optionsClass': 'kt-scrollable overflow-auto max-h-[250px]'}" })
            </div>
        </div>
        <div class="kt-card-footer d-flex justify-content-end p-5">
            <button class="kt-btn kt-btn-outline me-2" data-kt-drawer-dismiss="true" onclick="ClearFilterData()">Limpiar</button>
            <button class="kt-btn kt-btn-primary grow" data-kt-drawer-dismiss="true" onclick="SearchData()" id="btn_AplicarFiltro">Aplicar</button>
        </div>
    </div>
</div>
<!--end::Drawer-->

@section scripts {
	<script>
		$(document).ready(function () {
			LoadDataTable();
		});

		function ClearFilterData() {
            KTSelectHelper.setValue('#CategoryId', 1);
            KTSelectHelper.clear('#AccountTypeId');
            KTSelectHelper.clear('#InstrumentId');
            KTSelectHelper.clear('#FrameId');
            KTSelectHelper.clear('#DirectionId');

			LoadDataTable();
		}

		function SearchData() {
			LoadDataTable();
		}

		function LoadDataTable() {
			 const categoryId = $('#CategoryId').val() || 1;
			 const accountTypeId = $('#AccountTypeId').val() || 0;
			 const instrumentId = $('#InstrumentId').val() || 0;
			 const frameId = $('#FrameId').val() || 0;
			 const directionId = $('#DirectionId').val() || 0;

			 var data = {
				  categoryId: categoryId,
				  accountTypeId: accountTypeId,
				  instrumentId: instrumentId,
				  frameId: frameId,
				  directionId: directionId
			 };

            if ($.fn.DataTable.isDataTable('#dtTable')) {
                $('#dtTable').DataTable().destroy();
            }

			$('#dtTable').DataTable({
				ajax: {
					url: "@Url.Content("~/AnalyticsDay/JsonDataTable")",
					type: "POST",
					dataType: "json",
					data: data
				},
				columns: [
                    { name: "code", title: "Código", data: "code", autoWidth: true,  className: "min-w-[50px] w-[80px]" },
                    { name: "description", title: "Descripción", data: "description", autoWidth: true,  className: "text-center min-w-[200px] w-[250px]" },
                    { name: "quantity", title: "Cantidad", data: "quantity", autoWidth: true,  className: "text-center min-w-[50px] w-[100px]" },
                    { name: "sl", title: "SL", data: "sl", autoWidth: true, orderable: false,  className: "text-center min-w-[30px]", render: renderSLPChart },
                    { name: "tP1", title: "TP1", data: "tP1", autoWidth: true, orderable: false,  className: "text-center min-w-[30px]", render: renderTP1PChart },
                    { name: "tP2", title: "TP2", data: "tP2", autoWidth: true, orderable: false,  className: "text-center min-w-[30px]", render: renderTP2PChart},
                    { name: "tP3", title: "TP3", data: "tP3", autoWidth: true, orderable: false,  className: "text-center min-w-[30px]", render: renderTP3PChart },
                    { name: "valid", title: "Estatus", data: "valid", autoWidth: true, orderable: false,  className: "text-end min-w-[30px]  w-[80px]", render: renderStatusAnalytics }
				],
				processing: true,
				serverSide: true,
				pageLength: 10,
                searching: true,
                info: true,
                layout: {
                    topStart: [],
                    topEnd: 'search',
                    bottomStart: ['pageLength', 'info'],
                    bottomEnd: 'paging'
                },
				language: {
                    processing: "Procesando...",
                    lengthMenu: "Mostrar _MENU_ registros",
                    zeroRecords: "No se encontraron resultados",
                    emptyTable: "Ningún dato disponible en esta tabla",
                    info: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    infoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
                    infoFiltered: "(filtrado de un total de _MAX_ registros)",
                    search: "",
                    searchPlaceholder: "Buscar días...",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
				},
				drawCallback: function () {
					KTMenu.createInstances();

                    // animacion progress
                        requestAnimationFrame(() => {
                            setTimeout(() => {

                                document
                                    .querySelectorAll('.kt-progress-indicator')
                                    .forEach(el => {

                                        el.style.width = el.dataset.width + '%';

                                    });

                            }, 200);
                        });
				},
                initComplete: function () {
                    const api = this.api();
                    const searchInput = $('.dt-search input');
                    searchInput.addClass('kt-input');
                }
			});
		}
	</script>
}
