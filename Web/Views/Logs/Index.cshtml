@model List<Web.Models.LogsViewModel>

@{
	ViewData["Title"] = "Eventos";
}


<!-- Header Container -->
<div class="kt-container-fixed">
	<div class="flex flex-wrap items-center lg:items-end justify-between gap-5 pb-7.5">
		<div class="flex flex-col justify-center gap-2">
			<h1 class="text-xl font-medium leading-none text-mono">
				Registro de Eventos
			</h1>
			<div class="flex items-center gap-2 text-sm font-normal text-secondary-foreground">
				Consulta los eventos y acciones registradas en el sistema.
			</div>
		</div>
		<div class="flex items-center gap-2.5">
			<a class="kt-btn kt-btn-outline" data-kt-drawer-toggle="#filter_drawer">
				<i class="ki-filled ki-setting-4"></i>
				Filtro
			</a>
		</div>
	</div>
</div>
<!-- End of Header Container -->
<!-- Container -->
<div class="kt-container-fixed">
	<div class="grid" bis_skin_checked="1">
		<div class="kt-card kt-card-grid h-full min-w-full border border-white/5 shadow-2xs" bis_skin_checked="1">
			<div class="kt-card-table kt-scrollable-x-auto" bis_skin_checked="1">
				<table class="kt-table" data-kt-datatable-table="true" id="dtTable"></table>
			</div>
		</div>
	</div>
</div>
<!-- End of Container -->
<!--Filter Drawer-->
<div class="hidden kt-drawer kt-drawer-end card flex-col max-w-[90%] w-[450px] top-5 bottom-5 end-5 rounded-xl border border-border" data-kt-drawer="true" data-kt-drawer-container="body" id="filter_drawer">
	<div class="kt-card-header px-5">
		<h3 class="kt-card-title">
			Filtros Disponibles
		</h3>
		<button class="kt-btn kt-btn-sm kt-btn-icon kt-btn-ghost shrink-0" data-kt-drawer-dismiss="true">
			<i class="ki-filled ki-cross text-base">
			</i>
		</button>
	</div>
	<div class="kt-card-content space-y-5 p-5 kt-scrollable-y-auto">
		<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
			<label class="kt-form-label max-w-56">Rango de fechas:</label>
			<!--begin::Date Range Input-->
			<div class="kt-input w-full max-w-md min-w-[18rem]">
				<i class="ki-outline ki-calendar">
				</i>
				
				<input id="kt_daterangepicker_4"
					   class="input ps-10"
					   type="text"
					   placeholder="Seleccionar rango de fechas"
					   readonly />
			</div>
			<!--end::Date Range Input-->
		</div>
	</div>
	<div class="kt-card-footer p-5 flex gap-3">
		<a class="kt-btn kt-btn-outline" href="javascript:;" data-kt-drawer-dismiss="true">
			Limpiar
		</a>
		<a class="kt-btn kt-btn-primary grow" href="javascript:;" data-kt-drawer-dismiss="true" id="btn_AplicarFiltro">
			Aplicar
		</a>
	</div>
</div>
<!--End of Filter Drawer-->
@section scripts {	
	<script>
		$(document).ready(function () {
			// Inicialización de valores iniciales			
			let fechaInicio = moment().subtract(7, "days");
			let fechaFin = moment();

			KTFlatpickrHelper.initRange("#kt_daterangepicker_4");
			KTFlatpickrHelper.setRange("#kt_daterangepicker_4",fechaInicio,fechaFin);

			// Función para actualizar el campo y cargar la tabla
			function updateDateRange() {
				 const range = KTFlatpickrHelper.getRange("#kt_daterangepicker_4");
					
				 if (range.startFormatted && range.endFormatted) {
					 fechaInicio = range.startFormatted;
					 fechaFin = range.endFormatted;
                 } 

				 console.log("fecha1: " + fechaInicio);
				 console.log("fecha2: " + fechaFin);

			}


			// Función para cargar datos en la tabla
			function loadTableDate() {

				// Evita reinicialización incorrecta
				if ($.fn.DataTable.isDataTable('#dtTable')) {
					$('#dtTable').DataTable().destroy();
				}

				$('#dtTable').DataTable({
					ajax: {
						url: "@Url.Content("~/Logs/JsonDataTable")",
						type: "POST",
						dataType: "json",
						data: { fecha1: fechaInicio, fecha2: fechaFin }
					},
					columns: [
						{ name: "eventId", title: "ID", data: "eventId", autoWidth: true, className: "min-w-[50px]" },
						{
							name: "eventDate",
							title: "Fecha",
							data: "eventDate",
							autoWidth: true,
							className: "min-w-[50px]",
							render: function (data, type, row) {
								return type === 'display' || type === 'filter'
									? moment(data).format("DD/MM/YYYY HH:mm:ss")
									: data;
							}
						},
						{ name: "eventType", title: "Tipo de Evento", data: "eventType", autoWidth: true, className: "min-w-[100px]" },
						{ name: "description", title: "Descripción", data: "description", autoWidth: true, className: "min-w-[100px]" },
						{ name: "userName", title: "Usuario", data: "userName", autoWidth: false, className: "text-end min-w-[100px]" }
					],
					processing: true,
					serverSide: true,
					pageLength: 10,
					searching: true,
					language: {
						processing: "Procesando...",
						lengthMenu: "Mostrar _MENU_ registros",
						zeroRecords: "No se encontraron resultados",
						emptyTable: "Ningún dato disponible en esta tabla",
						info: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
						infoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
						infoFiltered: "(filtrado de un total de _MAX_ registros)",
						search: "",
						searchPlaceholder: "Buscar eventos...",
						paginate: {
							first: "Primero",
							last: "Último",
							next: "›",
							previous: "‹"
						},
						aria: {
							orderable: "Activar para ordenar ascendente",
							orderableReverse: "Activar para ordenar descendente"
						}
					},
					layout: {
						topStart: [],
						topEnd: 'search',
						bottomStart: ['pageLength', 'info'],
						bottomEnd: 'paging'
					},
					initComplete: function () {

						const searchContainer = $('.dt-search');

						searchContainer.find('label').remove();

						searchContainer.html(`
							<div class="kt-input max-w-48 relative">
							<i class="ki-filled ki-magnifier text-sm text-secondary-foreground"></i>
							<input
								id="dt-search-0"
								type="text"
								class="w-full "
								placeholder="Buscar eventos..."
							/>
							</div>
						`);

						searchContainer.find('input').on('keyup', function () {
							$('#dtTable').DataTable().search(this.value).draw();
						});

					},
					drawCallback: function () {
						KTMenu.createInstances();
					},
					order: [[0, "desc"]]
				});
			}

			// Evento click del botón aplicar filtro en el drawer
			const submitButton = document.getElementById('btn_AplicarFiltro');
			submitButton.addEventListener('click', function (e) {
				e.preventDefault();				

				// Llamar a la función inicial con valores predeterminados
				updateDateRange();

				loadTableDate();
			});

			// Llamar a la función inicial con valores predeterminados
			updateDateRange();

			// Recargar datos de la tabla
			loadTableDate();
		});

	</script>


}