									<span class="path2"></span>
								</i>
							</div>
						</div>
						<div class="flex flex-col gap-0.5" >
							<span class="leading-none font-medium text-base text-mono">
								SMS
							</span>
							<span class="text-sm text-secondary-foreground">
								Le enviaremos un código por SMS si necesita utilizar su método de inicio de sesión de respaldo.
							</span>
						</div>
						<input class="appearance-none" name="auth_option" type="radio" value="sms"  id="kt_modal_two_factor_authentication_option_2" disabled>
