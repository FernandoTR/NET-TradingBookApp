			</label>
		</div>
	</div>
	<!--begin::Actions-->
	<div class="kt-modal-footer gap-2.5 justify-end">
		<button type="button" id="kt_auth_options_button" class="kt-btn kt-btn-secondary" data-kt-element="options-select">Continuar</button>
	</div>
	<!--end::Actions-->
</div>
<!--end::Options-->
<!--begin::Apps-->
<div class="hidden" data-kt-element="apps">
	<!--begin::Form-->
	<form class="form" action="#" id="apps-form">
		<div class="kt-card-content grid gap-5">
			<div class="kt-form-description pb-5 text-2sm text-foreground" bis_skin_checked="1">
				Usando una aplicación de autenticación como
				<a class="kt-link" href="https://support.google.com/accounts/answer/1066447?hl=en" target="_blank">Google Authenticator</a>,
				<a class="kt-link" href="https://www.microsoft.com/en-us/account/authenticator" target="_blank">Microsoft Authenticator</a>,
				<a class="kt-link" href="https://authy.com/download/" target="_blank">Authy</a>, o
				<a class="kt-link" href="https://support.1password.com/one-time-passwords/" target="_blank">1Password</a>,
				escanea el código QR. Generará un código de 6 dígitos para que lo ingrese a continuación.
			</div>
			<div class="flex flex-col items-center gap-2 lg:gap-3.5 py-4 lg:pt-5 lg:pb-5">
				<img class="h-56 " src="@Url.Action("Generate", "Manage", new { content = Model.AuthenticatorUri ?? string.Empty })" alt="Código QR">
			</div>
			<label class="flex align-stretch cursor-pointer bg-center h-24 bg-no-repeat border border-input rounded-xl border-dashed has-checked:border-primary bg-[length:500px] sso-active singl-sign-on-bg">
				<div class="flex flex-wrap items-center justify-between gap-5">
					<div class="flex items-center gap-2.5 ml-5">
						<div class="relative size-[44px] shrink-0">
							<svg class="w-full h-full stroke-border fill-muted/30" fill="none" height="48" viewBox="0 0 44 48" width="44" xmlns="http://www.w3.org/2000/svg">
								<path d="M16 2.4641C19.7128 0.320509 24.2872 0.320508 28 2.4641L37.6506 8.0359C41.3634 10.1795 43.6506 14.141 43.6506
									18.4282V29.5718C43.6506 33.859 41.3634 37.8205 37.6506 39.9641L28 45.5359C24.2872 47.6795 19.7128 47.6795 16 45.5359L6.34937
									39.9641C2.63655 37.8205 0.349365 33.859 0.349365 29.5718V18.4282C0.349365 14.141 2.63655 10.1795 6.34937 8.0359L16 2.4641Z" fill="">
								</path>
								<path d="M16.25 2.89711C19.8081 0.842838 24.1919 0.842837 27.75 2.89711L37.4006 8.46891C40.9587 10.5232 43.1506 14.3196 43.1506
									18.4282V29.5718C43.1506 33.6804 40.9587 37.4768 37.4006 39.5311L27.75 45.1029C24.1919 47.1572 19.8081 47.1572 16.25 45.1029L6.59937
									39.5311C3.04125 37.4768 0.849365 33.6803 0.849365 29.5718V18.4282C0.849365 14.3196 3.04125 10.5232 6.59937 8.46891L16.25 2.89711Z" stroke="">
								</path>
							</svg>
							<div class="absolute leading-none start-2/4 top-2/4 -translate-y-2/4 -translate-x-2/4 rtl:translate-x-2/4">
								<i class="ki-filled ki-information text-xl text-muted-foreground">
									<span class="path1"></span>
									<span class="path2"></span>
								</i>
							</div>
						</div>
						<div class="flex flex-col gap-0.5">
							<span class="kt-form-description text-2sm text-muted-foreground mb-1">
								Si tiene problemas para usar el código QR, seleccione la entrada manual en su aplicación e ingrese su nombre de usuario y el código:
							</span>
							<span class="text-base font-medium text-mono hover:text-primary" id="kt_twofactor_code">
								@Model.SharedKey
							</span>
						</div>
					</div>
				</div>
			</label>
			<div class="w-full fv-row">
				<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" >				
					<input class="kt-input" placeholder="Introduzca el código de autenticación" type="text" value="" id="codeAuthentication" name="codeAuthentication" maxlength="6">
				</div>
			</div>
		

		</div>

		<!--begin::Actions-->
		<div class="kt-modal-footer gap-2.5 justify-end">
			<button type="button" id="apps-cancel" class="kt-btn kt-btn-secondary">Cancelar</button>
			<button type="button" id="apps-submit" class="kt-btn kt-btn-primary">Enviar</button>
		</div>
		<!--end::Actions-->
		
	</form>
	<!--end::Form-->
</div>
<!--end::Options-->
<!--begin::SMS-->
<div class="hidden" data-kt-element="sms">
	<!--begin::Heading-->
	<h3 class="text-gray-900 fw-bold fs-3 mb-5">SMS: Verify Your Mobile Number</h3>
	<!--end::Heading-->
	<!--begin::Notice-->
	<div class="text-muted fw-semibold mb-10">Enter your mobile phone number with country code and we will send you a verification code upon request.</div>
	<!--end::Notice-->
	<!--begin::Form-->
	<form id="sms-form" class="form" action="#">
		<!--begin::Input group-->
		<div class="mb-10 fv-row">
			<input type="text" class="form-control form-control-lg form-control-solid" placeholder="Mobile number with country code..." name="mobile" />
		</div>
		<!--end::Input group-->
		<!--begin::Actions-->
		<div class="d-flex flex-center">
			<button type="button" id="sms-cancel" class="btn btn-light me-3" data-bs-dismiss="modal">Cancelar</button>
			<button type="button" id="sms-submit" class="btn btn-primary">
				<span class="indicator-label">Enviar</span>
				<span class="indicator-progress">
					Espere por favor...
					<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
				</span>
			</button>
		</div>
		<!--end::Actions-->
	</form>
	<!--end::Form-->
</div>
<!--end::SMS-->
<!--end::Modal - Two-factor authentication-->
<script>
	$(document).ready(function () {
		const optionsSection = document.querySelector('[data-kt-element="options"]');
		const appsSection = document.querySelector('[data-kt-element="apps"]');
		const smsSection = document.querySelector('[data-kt-element="sms"]');

		const continueBtn = document.querySelector('[data-kt-element="options-select"]');

		const appsCancelBtn = document.getElementById('apps-cancel');
		const smsCancelBtn = document.getElementById('sms-cancel');

		const appsSubmitBtn = document.getElementById('apps-submit');
		const smsSubmitBtn = document.getElementById('sms-submit');

		function showOptions() {
			optionsSection.classList.remove('hidden');
			appsSection.classList.add('hidden');
			smsSection.classList.add('hidden');
		}

		function showApps() {
			optionsSection.classList.add('hidden');
			appsSection.classList.remove('hidden');
			smsSection.classList.add('hidden');
		}

		function showSms() {
			optionsSection.classList.add('hidden');
			appsSection.classList.add('hidden');
			smsSection.classList.remove('hidden');
		}

		// CONTINUAR
		continueBtn.addEventListener('click', () => {
			// Obtener la opción seleccionada
			const selected = document.querySelector(
				'input[name="auth_option"]:checked'
			);

			if (!selected) {
				alert('Seleccione una opción');
				return;
			}

			// Mostrar la opción seleccionada
			switch (selected.value) {
				case 'apps':
					showApps();
					break;

				case 'sms':
					showSms();
					break;
			}
		});

		// CANCELAR
		appsCancelBtn?.addEventListener('click', showOptions);
		smsCancelBtn?.addEventListener('click', showOptions);

		// ENVIAR APPS
		appsSubmitBtn?.addEventListener('click', async () => {
			// Validate form before submit
			if (validator) {
				validator.validate().then(function (status) {

					if (status == 'Valid') {

						// Disable button to avoid multiple click
						appsSubmitBtn.disabled = true;

						EnableTwoFactor();
					}
				});
			}
		});

		// ENVIAR SMS
		// smsSubmitBtn?.addEventListener('click', async () => {

		// });


		// Define form element kt_signin_change_email
		let form = document.getElementById('apps-form');
		var validator = FormValidation.formValidation(
			form,
			{
				fields: {
					'codeAuthentication': {
						validators: {
							notEmpty: {
								message: 'El código es obligatorio'
							},
							stringLength: {
								max: 6,
								message: 'Sobrepasa el límite de 6 caracteres'
							},
							
						}
					},					
				},
				plugins: {
					trigger: new FormValidation.plugins.Trigger(),
					submitButton: new FormValidation.plugins.SubmitButton(),
					message: new FormValidation.plugins.Message({
						clazz: 'text-red-500 text-sm mt-1',
						container: function (field, element) {
							return element.closest('.fv-row');
						}
					}),
				}

			}
		);

	

		function EnableTwoFactor() {
			const code = document.querySelector('#codeAuthentication').value;
			const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

			
			var url = "@Url.Content("~/Manage/VerifyAuthenticatorCode")";
			fetch(url, {
				method: 'POST',
				body: JSON.stringify(code),
				headers: {
					'Content-Type': 'application/json',
					'RequestVerificationToken': token
				}
			}).then(res => res.json())
			.catch(error => console.error('Error:', error))
			.then((data) => {
				

				// Disable button to avoid multiple click
				appsSubmitBtn.disabled = false;

				ShowNotification(data.notificationType, data.message);

				if(data.success)
				{
					document.getElementById('codeAuthentication').value = '';

					$("#kt_modal_two_factor_authentication").modal("hide");

					LoadSettingsView();
				}

				

			});
		}



		// Estado inicial
		showOptions();

	});
</script>