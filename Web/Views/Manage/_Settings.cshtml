			</button>
		</div>
		<!--begin::Edit-->
		<div class="flex flex-col gap-1.5 hidden" id="kt_signin_password_edit">
			<!--begin::Form-->
			<form id="kt_signin_change_password" novalidate="novalidate">
				@Html.AntiForgeryToken()
				<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Contraseña actual:</label>
							<input type="password" class="kt-input" name="currentpassword" id="currentpassword" />							
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Nueva Contraseña:</label>
							<input type="password" class="kt-input" name="newpassword" id="newpassword" />
							
						</div>
					</div>
					<div class="w-full fv-row">
						<div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
							<label class="kt-form-label max-w-56">Confirmar Nueva Contraseña:</label>
							<input type="password" class="kt-input" name="confirmpassword" id="confirmpassword" />
						</div>
					</div>
					<span class="kt-form-description text-2sm text-primary">
						La contraseña debe tener al menos 8 caracteres con una combinación de letras, números y simbolos.
					</span>
				</div>
			</form>
			<!--end::Form-->
		</div>
		<div class="flex items-center gap-2.5 hidden" id="kt_signin_password_edit_buttons">
			<button class="kt-btn kt-btn-outline kt-btn-primary shrink-0" id="kt_password_submit" type="button">
				Actualizar
			</button>
			<button class="kt-btn kt-btn-outline shrink-0" id="kt_password_cancel" type="button">
				Cancelar
			</button>
		</div>

			
		<!--end::Edit-->
	</div>
	<!--end::Password-->
	<!--begin::TwoFactor-->
