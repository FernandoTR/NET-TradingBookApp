@model Web.Models.AccountsViewModel

@{
    Layout = null;
}



<form id="frmdata">
    @Html.AntiForgeryToken()

    <div class="kt-card-content grid gap-5">
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.CurrentBalance, new { @class = "kt-form-label max-w-56 required" })
                @Html.TextBoxFor(d => d.CurrentBalance, new { @class = "kt-input", disabled = true })

            </div>
        </div>
        <!--end::Input group-->
        <!--begin::Input group-->
        <div class="w-full fv-row">
            <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5" bis_skin_checked="1">
                @Html.LabelFor(d => d.Cash, new { @class = "kt-form-label max-w-56 required" })
                @Html.TextBoxFor(d => d.Cash, new { @class = "kt-input", Maxlength = 15, autocomplete = "off" })

            </div>
        </div>
        <!--end::Input group-->
    </div>

    <!--begin::Actions-->
    <div class="kt-modal-footer gap-2.5 justify-end">
        <button type="button" id="kt_modal_new_target_cancel" class="kt-btn kt-btn-secondary" data-kt-modal-dismiss="#vModal">Cancelar</button>
        <button type="button" id="btnSave" class="kt-btn kt-btn-primary">Guardar</button>
    </div>
    <!--end::Actions-->
    <div hidden>
        @Html.HiddenFor(d => d.Id)
        @Html.HiddenFor(d => d.UserId)
        @Html.HiddenFor(d => d.CatAccountTypeId)
        @Html.HiddenFor(d => d.CatAccountTypeId)
        @Html.HiddenFor(d => d.InitialBalance)
        @Html.HiddenFor(d => d.Currency)
    </div>
</form>


<script> 

    $(document).ready(function () {
        InputMaskHelper.decimal('#CurrentBalance');
        InputMaskHelper.decimal('#Cash');


        // Define form element
        let form = document.getElementById('frmdata');

        // Init form validation rules.
        var validator = FormValidation.formValidation(
            form,
            {
                fields: {
                    'Cash': {
                        validators: {
                            notEmpty: {
                                message: 'La cantidad es obligatoria'
                            }, 
                            callback: {
                                message: 'El monto debe ser mayor a cero',
                                callback: function (input) {
                                    const cashValue = parseFloat(input.value.replace(/[^0-9.-]+/g, '')) || 0; // Convierte a número

                                    return cashValue > 0;
                                },
                            },
                        }
                    },
                },
                plugins: {
					trigger: new FormValidation.plugins.Trigger(),
					submitButton: new FormValidation.plugins.SubmitButton(),
					message: new FormValidation.plugins.Message({
						clazz: 'text-red-500 text-sm mt-1',
						container: function (field, element) {
							return element.closest('.fv-row');
						}
					}),
				}

            }
        );

        // Submit button handler
        const submitButton = document.getElementById('btnSave');
        submitButton.addEventListener('click', function (e) {
            // Prevent default button action
            e.preventDefault();

            // Validate form before submit
            if (validator) {
                validator.validate().then(function (status) {
                    if (status == 'Valid') {
                        // Show loading indication
                        submitButton.setAttribute('data-kt-indicator', 'on');

                        // Disable button to avoid multiple click
                        submitButton.disabled = true;


                        AddCash();
                    }
                });
            }
        });

         function AddCash() {
            const id = parseInt(document.querySelector('#Id').value);
            const cash = parseFloat(document.querySelector('#Cash').value);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Crear el objeto de datos para enviar
            const data = {
                Id: id,
                Cash: cash.toFixed(2)
            };

            var url = "@Url.Content("~/Manage/AddCash")";
            fetch(url, {
                method: 'POST',
                body: JSON.stringify(data),
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            }).then(res => res.json())
            .catch(error => console.error('Error:', error))
            .then((data) => {

                // Disable button to avoid multiple click
                submitButton.disabled = false;

                ShowNotification(data.notificationType, data.message);

                if(data.success)
                {
                   const modalEl = document.querySelector('#vModal');
					const modal = KTModal.getInstance(modalEl);
					modal.hide();

                   LoadBalanceView();
                }


            });


        }


    });
</script>