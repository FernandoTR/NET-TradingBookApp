@model Web.Models.OverviewViewModel

<!--begin::details View-->
<div class="kt-card" id="kt_profile_details_view">
	<div class="kt-card-header" >
		<h3 class="kt-card-title">
			Detalles del perfil
		</h3>
	</div>
	<div class="kt-card-content pt-4 pb-3" >
		<table class="kt-table-auto">
			<tbody>
				<tr>
					<td class="text-sm text-secondary-foreground pb-3.5 pe-3">
						Número de Empleado:
					</td>
					<td class="text-sm text-mono pb-3.5">
						@Model.EmployeeNumber
					</td>
				</tr>
				<tr>
					<td class="text-sm text-secondary-foreground pb-3.5 pe-3">
						Nombre completo:
					</td>
					<td class="text-sm text-mono pb-3.5">
						@Model.FullName
					</td>
				</tr>
				<tr>
					<td class="text-sm text-secondary-foreground pb-3.5 pe-3">
						Roles:
					</td>
					<td class="text-sm text-mono pb-3.5">
						@Model.Roles
					</td>
				</tr>
				<tr>
					<td class="text-sm text-secondary-foreground pb-3.5 pe-3">
						Teléfono:
					</td>
					<td class="text-sm text-mono pb-3.5">
						@Model.PhoneNumber 
						@if (!string.IsNullOrEmpty(@ViewBag.PhoneNumber))
						{
							<span class="kt-badge kt-badge-success">Verificado</span>
						}
					</td>
				</tr>
				<tr>
					<td class="text-sm text-secondary-foreground pb-3.5 pe-3">
						Correo Electrónico:
					</td>
					<td class="text-sm text-mono pb-3.5">
						<a class="text-foreground hover:text-primary" href="#" id="lbl_email_Overview">
							@Model.Email
						</a>
						
					</td>
				</tr>
				<tr>
					<td class="text-sm text-secondary-foreground pb-3.5 pe-3">
						Correo electrónico confirmado:
					</td>
					<td class="text-sm text-mono pb-3.5">
						@Model.EmailConfirmed
					</td>
				</tr>
				<tr>
					<td class="text-sm text-secondary-foreground pb-3.5 pe-3">
						Ubicación:
					</td>
					<td class="text-sm text-mono pb-3.5">
						@Model.Location
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>
<!--end::details View-->