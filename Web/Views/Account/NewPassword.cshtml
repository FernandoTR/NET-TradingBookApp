@model Web.Models.ResetPasswordViewModel
@{
	ViewBag.Title = "Nueva contraseña";
}

<!DOCTYPE html>
<html lang="es" class="h-full dark" data-kt-theme="true" data-kt-theme-mode="light" dir="ltr" data-kt-theme-swtich-initialized="true" data-kt-theme-switch-mode="dark">
<head>
	<title>Olvidó su contraseña - Trading Book</title>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta charset="utf-8" />
	<meta name="description" content="Trading Book" />
	<meta name="keywords" content="Trading Book" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta property="og:locale" content="es_ES" />
	<meta property="og:type" content="article" />
	<meta property="og:title" content="Trading Book" />
	<meta property="og:url" content="#" />
	<meta property="og:site_name" content="WebAppBase" />
	<link rel="canonical" href="#" />
	<link rel="shortcut icon" href="~/favicon.ico" />
	<!--begin::Fonts(mandatory for all pages)-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" />
	<!--end::Fonts-->
	<!--begin::Vendor Stylesheets(used for this page only)-->
	<link href="~/Template/assets/vendors/keenicons/styles.bundle.css" rel="stylesheet" type="text/css" />
	<link href="~/Template/assets/css/styles.css" rel="stylesheet" type="text/css" />
	<link href="~/Template/assets/vendors/form-validation/index.min.css" rel="stylesheet" type="text/css" />
	<!--end::Vendor Stylesheets-->
	<!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
	<!--end::Global Stylesheets Bundle-->

</head>
<body id="kt_app_body" class="antialiased flex h-full text-base text-foreground bg-background demo1 kt-sidebar-fixed kt-header-fixed">
	<!-- Page -->
	<style>
			.page-bg {
				background-image: radial-gradient(600px, rgba(59, 130, 246, 0.3), transparent);
			}

			.dark .page-bg {
				background-color: radial-gradient(circle 600px at 50% 50%, rgba(59,130,246,0.3), transparent);
			}
	</style>

	<div class="flex items-center justify-center grow bg-center bg-no-repeat page-bg">
		<div class="kt-card max-w-[370px] w-full">
			@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "kt-card-content flex flex-col gap-5 p-10",  id = "myForm" }))
			{
				@Html.AntiForgeryToken()
				@Html.HiddenFor(model => model.Code)
				@Html.HiddenFor(model => model.Email)
				<div class="text-center mb-2.5">
					<h3 class="text-lg font-medium text-mono leading-none mb-2.5">
						Restablecer contraseña
					</h3>
					<div class="text-sm text-secondary-foreground">
						Introduce tu nueva contraseña
					</div>
				</div>
				<div class="fv-row flex flex-col gap-1" >
					<label class="kt-form-label text-mono">
						Nueva Contraseña
					</label>
					<label class="kt-input" data-kt-toggle-password="true" data-kt-toggle-password-initialized="true">
						@Html.PasswordFor(m => m.Password, new { @class = "kt-input", autocomplete = "off", id = "Password", placeholder = "Contraseña" })
						<div class="kt-btn kt-btn-sm kt-btn-ghost kt-btn-icon bg-transparent! -me-1.5" data-kt-toggle-password-trigger="true" >
							<span class="kt-toggle-password-active:hidden">
								<i class="ki-filled ki-eye text-muted-foreground">
								</i>
							</span>
							<span class="hidden kt-toggle-password-active:block">
								<i class="ki-filled ki-eye-slash text-muted-foreground">
								</i>
							</span>
						</div>
					</label>
				</div>
				<div class="flex flex-col gap-1" >
					<label class="kt-form-label font-normal text-mono">
						Confirmar nueva contraseña
					</label>
					<label class="kt-input" data-kt-toggle-password="true" data-kt-toggle-password-initialized="true">
						@Html.PasswordFor(m => m.ConfirmPassword, new { @class = "kt-input", autocomplete = "off", id = "ConfirmPassword", placeholder = "Repita la contraseña" })
						<div class="kt-btn kt-btn-sm kt-btn-ghost kt-btn-icon bg-transparent! -me-1.5" data-kt-toggle-password-trigger="true" >
							<span class="kt-toggle-password-active:hidden">
								<i class="ki-filled ki-eye text-muted-foreground">
								</i>
							</span>
							<span class="hidden kt-toggle-password-active:block">
								<i class="ki-filled ki-eye-slash text-muted-foreground">
								</i>
							</span>
						</div>
					</label>
				</div>
				<button type="button" class="kt-btn kt-btn-primary flex justify-center grow" id="kt_new_password_submit">
					Enviar
				</button>
			}
		</div>
	</div>




	<!--begin::Global Javascript Bundle(mandatory for all pages)-->
	<script src="~/Template/assets/js/core.bundle.js"></script>
	<script src="~/Template/assets/vendors/ktui/ktui.min.js"></script>
	<script src="~/Template/assets/vendors/form-validation/form-validation.bundle.js"></script>

	<!--end::Global Javascript Bundle-->
	<!-- End of Page -->

</body>
</html>


<script type="text/javascript">
		// Define form element
		const form = document.getElementById('myForm');

		// Init form validation rules. For more info check the FormValidation plugin's official documentation:https://formvalidation.io/
		var validator = FormValidation.formValidation(
			form,
			{
				fields: {
					'Password': {
						validators: {
							notEmpty: {
								message: 'La contraseña es obligatoria'
							}
						}
					},
					'ConfirmPassword': {
						validators: {
							notEmpty: {
								message: 'La confirmación de la contraseña es obligatoria'
							},
							identical: {
								compare: function() {
									return form.querySelector('[name="Password"]').value;
								},
								message: 'Las contraseñas no coinciden'
							}
						}
					},
				},

				plugins: {

					trigger: new FormValidation.plugins.Trigger(),
					submitButton: new FormValidation.plugins.SubmitButton(),

					message: new FormValidation.plugins.Message({
					clazz: 'text-red-500 text-sm mt-1',
					container: function (field, element) {
					return element.closest('.fv-row');
					}
					}),
				}
				
			}
		);


		// Submit button handler
		const submitButton = document.getElementById('kt_new_password_submit');
		submitButton.addEventListener('click', function (e) {
			// Prevent default button action
			e.preventDefault();

			// Validate form before submit
			if (validator) {
				validator.validate().then(function (status) {				

					if (status == 'Valid') {

						// Disable button to avoid multiple click
						submitButton.disabled = true;

						form.submit(); // Submit form
					}
				});
			}
		});

	</script>

