@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" class="h-full dark" data-kt-theme="true" data-kt-theme-mode="light" dir="ltr" data-kt-theme-swtich-initialized="true" data-kt-theme-switch-mode="dark">
<head>
    <title>Iniciar sesión - Trading Book</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="description" content="Trading Book" />
    <meta name="keywords" content="Trading Book" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="Trading Book" />
    <meta property="og:url" content="#" />
    <meta property="og:site_name" content="WebAppBase" />
    <link rel="canonical" href="#" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <!--begin::Fonts(mandatory for all pages)-->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" />
    <!--end::Fonts-->
    <!--begin::Vendor Stylesheets(used for this page only)-->
    <link href="~/Template/assets/vendors/keenicons/styles.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/Template/assets/css/styles.css" rel="stylesheet" type="text/css" />
    <link href="~/Template/assets/vendors/form-validation/index.min.css" rel="stylesheet" type="text/css" />
    <!--end::Vendor Stylesheets-->
    <!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
    <!--end::Global Stylesheets Bundle-->

</head>
<body id="kt_app_body" class="antialiased flex h-full text-base text-foreground bg-background demo1 kt-sidebar-fixed kt-header-fixed">
    <!-- Page -->
    <style>
            .page-bg {
                background-image: radial-gradient(600px, rgba(59, 130, 246, 0.3), transparent);
            }

            .dark .page-bg {
                /* background-image: url('../Template/assets_Tailwind/media/images/2600x1200/bg-10-dark.png'); */
                background-color: radial-gradient(circle 600px at 50% 50%, rgba(59,130,246,0.3), transparent);
            }
    </style>

    <div class="flex items-center justify-center grow bg-center bg-no-repeat page-bg">
        <div class="kt-card max-w-[370px] w-full">
            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, new { @class = "kt-card-content flex flex-col gap-5 p-10", @id = "loginForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="text-center mb-2.5">
                    <h3 class="text-lg font-medium text-mono leading-none mb-2.5">
                        Iniciar Sesión
                    </h3>
                    <div class="flex items-center justify-center font-medium">
                        <a class="text-sm link" href="html/demo1/authentication/classic/sign-up.html">
                            Trading Book
                        </a>
                    </div>
                </div>

                <div class="fv-row flex flex-col gap-1">
                    <label class="kt-form-label font-normal text-mono">
                        Correo Electrónico
                    </label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "kt-input", autocomplete = "off", placeholder = "email@email.com" })
                </div>
                <div class="fv-row flex flex-col gap-1">
                    <div class="flex items-center justify-between gap-1">
                        <label class="kt-form-label font-normal text-mono">
                            Password
                        </label>
                        <a class="text-sm kt-link shrink-0" href="@Url.Action("ResetPassword", "Account")">
                            Olvidadó su contraseña ?
                        </a>
                    </div>
                    <div class="kt-input" data-kt-toggle-password="true">
                        @Html.PasswordFor(m => m.Password, new { @class = "kt-input", autocomplete = "off", placeholder = "Ingresa contraseña" })

                        <button class="kt-btn kt-btn-sm kt-btn-ghost kt-btn-icon bg-transparent! -me-1.5" data-kt-toggle-password-trigger="true" type="button">
                            <span class="kt-toggle-password-active:hidden">
                                <i class="ki-filled ki-eye text-muted-foreground">
                                </i>
                            </span>
                            <span class="hidden kt-toggle-password-active:block">
                                <i class="ki-filled ki-eye-slash text-muted-foreground">
                                </i>
                            </span>
                        </button>
                    </div>
                </div>
                <button id="kt_sign_in_submit" class="kt-btn kt-btn-primary flex justify-center grow">
                    Iniciar sesión
                </button>
            }
        </div>
    </div>




    <!--begin::Global Javascript Bundle(mandatory for all pages)-->
    <script src="~/Template/assets/js/core.bundle.js"></script>
    <script src="~/Template/assets/vendors/ktui/ktui.min.js"></script>
    <script src="~/Template/assets/vendors/form-validation/form-validation.bundle.js"></script>

    <!--end::Global Javascript Bundle-->
    <!-- End of Page -->

</body>
</html>




<script type="text/javascript">

    document.addEventListener('DOMContentLoaded', function () {

    const form = document.getElementById('loginForm');

    const submitButton = document.getElementById('kt_sign_in_submit');

    const validator = FormValidation.formValidation(
    form,
    {
    fields: {

    Email: {
    validators: {

    notEmpty: {
    message: 'El email es obligatorio'
    },

    emailAddress: {
    message: 'El formato del email no es válido'
    }
    }
    },

    Password: {
    validators: {

    notEmpty: {
    message: 'La contraseña es obligatoria'
    }
    }
    }
    },

    plugins: {

    trigger:
    new FormValidation.plugins.Trigger(),

    submitButton:
    new FormValidation.plugins.SubmitButton(),

    message:
    new FormValidation.plugins.Message({
    clazz: 'text-red-500 text-sm mt-1',
    container: function (field, element) {
    return element.closest('.fv-row');
    }
    }),
    }
    }
    )

    .on('core.element.validated', function (e) {

    if (e.valid) {

    //e.element.classList.remove('border-red-500','ring-1','ring-red-500');
    e.element.classList.add('border-green-500');

    } else {

    e.element.classList.remove('border-green-500');
    //e.element.classList.add('border-red-500','ring-1','ring-red-500');
    }
    });

    submitButton.addEventListener('click', function (e) {

    e.preventDefault();

    validator.validate().then(function (status) {

    if (status === 'Valid') {

    submitButton.disabled = true;

    form.submit();
    }
    });
    });


    });

</script>


