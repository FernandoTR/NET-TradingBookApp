@model Web.Models.Send2FACodeViewModel
@{
	// ViewBag.Title = "Verificación de Dos Factores";
	Layout = null;
}

<!DOCTYPE html>
<html lang="es" class="h-full dark" data-kt-theme="true" data-kt-theme-mode="light" dir="ltr" data-kt-theme-swtich-initialized="true" data-kt-theme-switch-mode="dark">
<head>
	<title>Verificación de Dos Factores - Trading Book</title>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta charset="utf-8" />
	<meta name="description" content="Trading Book" />
	<meta name="keywords" content="Trading Book" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta property="og:locale" content="es_ES" />
	<meta property="og:type" content="article" />
	<meta property="og:title" content="Trading Book" />
	<meta property="og:url" content="#" />
	<meta property="og:site_name" content="WebAppBase" />
	<link rel="canonical" href="#" />
	<link rel="shortcut icon" href="~/favicon.ico" />
	<!--begin::Fonts(mandatory for all pages)-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" />
	<!--end::Fonts-->
	<!--begin::Vendor Stylesheets(used for this page only)-->
	<link href="~/Template/assets/vendors/keenicons/styles.bundle.css" rel="stylesheet" type="text/css" />
	<link href="~/Template/assets/css/styles.css" rel="stylesheet" type="text/css" />
	<link href="~/Template/assets/vendors/form-validation/index.min.css" rel="stylesheet" type="text/css" />
	<!--end::Vendor Stylesheets-->
	<!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
	<!--end::Global Stylesheets Bundle-->

</head>
<body id="kt_app_body" class="antialiased flex h-full text-base text-foreground bg-background demo1 kt-sidebar-fixed kt-header-fixed">
	<!-- Page -->
	<style>
			.page-bg {
				background-image: radial-gradient(600px, rgba(59, 130, 246, 0.3), transparent);
			}

			.dark .page-bg {
				background-color: radial-gradient(circle 600px at 50% 50%, rgba(59,130,246,0.3), transparent);
			}
	</style>

	<div class="flex items-center justify-center grow bg-center bg-no-repeat page-bg">
		<div class="kt-card max-w-[370px] w-full">
			@using (Html.BeginForm("Verify2FACode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, true, new { @class = "kt-card-content flex flex-col gap-5 p-10",  id = "myForm" }))
			{
				@Html.AntiForgeryToken()
				@Html.Hidden("Code", @Model.Code)
				@Html.Hidden("Provider", @Model.Provider)
				@Html.Hidden("ReturnUrl", @Model.ReturnUrl)
				@Html.Hidden("RememberMe", @Model.RememberMe)
				@Html.Hidden("UserId", @Model.UserId)


				<div class="text-center mb-2.5">
					<h3 class="text-lg font-medium text-mono leading-none mb-2.5">
						Verificación de Dos Factores
					</h3>
					<div class="flex flex-col" >
						<span class="text-sm text-secondary-foreground mb-1.5">
							@(Model.Provider != "Authenticator" ? "Ingresa el código de verificación que acabamos de enviar a" : "Revise su aplicación preferida para códigos de un solo uso y copie el código")
						</span>
						<a class="text-sm font-medium text-mono" href="#">
							@(Model.Provider != "Authenticator" ? Model.SendTo : "")
						</a>
					</div>
				</div>
				<div class="flex flex-wrap justify-center gap-2.5" data-kt-pin-input="true" data-kt-pin-input-name="verification_code" data-kt-pin-input-initialized="true" bis_skin_checked="1">
					<input name="code_1" aria-label="Digit 1 of 6" autocomplete="one-time-code" class="kt-input focus:border-primary/10 focus:ring-3 focus:ring-primary/10 size-10 shrink-0 px-0 text-center" data-kt-pin-input-item="" inputmode="numeric" maxlength="1" type="tel">
					<input name="code_2" aria-label="Digit 2 of 6" autocomplete="off" class="kt-input focus:border-primary/10 focus:ring-3 focus:ring-primary/10 size-10 shrink-0 px-0 text-center" data-kt-pin-input-item="" inputmode="numeric" maxlength="1" type="text">
					<input name="code_3" aria-label="Digit 3 of 6" autocomplete="off" class="kt-input focus:border-primary/10 focus:ring-3 focus:ring-primary/10 size-10 shrink-0 px-0 text-center" data-kt-pin-input-item="" inputmode="numeric" maxlength="1" type="text">
					<input name="code_4" aria-label="Digit 4 of 6" autocomplete="off" class="kt-input focus:border-primary/10 focus:ring-3 focus:ring-primary/10 size-10 shrink-0 px-0 text-center" data-kt-pin-input-item="" inputmode="numeric" maxlength="1" type="text">
					<input name="code_5" aria-label="Digit 5 of 6" autocomplete="off" class="kt-input focus:border-primary/10 focus:ring-3 focus:ring-primary/10 size-10 shrink-0 px-0 text-center" data-kt-pin-input-item="" inputmode="numeric" maxlength="1" type="text">
					<input name="code_6" aria-label="Digit 6 of 6" autocomplete="off" class="kt-input focus:border-primary/10 focus:ring-3 focus:ring-primary/10 size-10 shrink-0 px-0 text-center" data-kt-pin-input-item="" inputmode="numeric" maxlength="1" type="text">
					<input type="hidden" name="verification_code" data-kt-pin-input-hidden="true" value="">
				</div>

				<button type="button" class="kt-btn kt-btn-primary flex justify-center grow" id="kt_sing_in_two_factor_submit">
					Continuar
				</button>
				
			}
		</div>
	</div>




	<!--begin::Global Javascript Bundle(mandatory for all pages)-->
	<script src="~/Template/assets/js/core.bundle.js"></script>
	<script src="~/Template/assets/vendors/ktui/ktui.min.js"></script>
	<script src="~/Template/assets/vendors/form-validation/form-validation.bundle.js"></script>

	<!--end::Global Javascript Bundle-->
	<!-- End of Page -->

</body>
</html>



<script type="text/javascript">
		$(document).ready(function() {
			const inputs = document.querySelectorAll("#input-container input");

			inputs.forEach((input, index) => {
			  input.addEventListener("input", function () {
				if (input.value.length === input.maxLength) {
				  // Mueve el foco al siguiente input si existe
				  const nextInput = inputs[index + 1];
				  if (nextInput) {
					nextInput.focus();
				  }
				}
			  });

			  // Permitir retroceso al input anterior
			  input.addEventListener("keydown", function (e) {
				if (e.key === "Backspace" && input.value === "") {
				  const prevInput = inputs[index - 1];
				  if (prevInput) {
					prevInput.focus();
				  }
				}
			  });
			});

			


		});

		// Define form element
		const form = document.getElementById('myForm');

		function validateInputs() {
			// Recupera todos los inputs cuyo nombre empiece con "code_"
			const inputs = document.querySelectorAll('input[name^="code_"]');

			// Concatena los valores de los inputs
			const code = Array.from(inputs).map(input => input.value).join('');
			
			// Retorna true si la longitud del código es exactamente 6
			document.getElementById('Code').value = code;
			return code.length === 6;
		}


		// Submit button handler
		const submitButton = document.getElementById('kt_sing_in_two_factor_submit');
		submitButton.addEventListener('click', function (e) {
			// Prevent default button action
			e.preventDefault();

			// Validate form 
			if (!validateInputs())
			{
				ShowNotification(4,"Ingrese un código de seguridad válido e inténtelo nuevamente.")
				return;
			}

			// Show loading indication
			submitButton.setAttribute('data-kt-indicator', 'on');

			// Disable button to avoid multiple click
			submitButton.disabled = true;

			form.submit(); 
		});

		function setTempData() {
			const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

			// Crear los datos a enviar
			const model = {
				Provider: document.querySelector('#Provider')?.value || "",
				Code: "",
				ReturnUrl: document.querySelector('#ReturnUrl')?.value || "",
				RememberBrowser: document.querySelector('#RememberBrowser')?.value === "true",
				RememberMe: document.querySelector('#RememberMe')?.value === "true",
				UserId: document.querySelector('#UserId')?.value || "",
				SendTo: ""
			};

			const url = "@Url.Content("~/Account/SetTempData")";
			fetch(url, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'RequestVerificationToken': token
				},
				body: JSON.stringify(model)
			})
			.then(response => response.json())
			.then(data => {
				if (data.success) {
					window.location.href = data.redirectUrl;
				} else {
					console.error('Error al procesar la solicitud');
				}
			})
			.catch(error => console.error('Error:', error));
			
		}
	</script>
